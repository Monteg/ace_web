---
import Base from '../layouts/Base.astro';
import { CTA } from '../data/site';
import { getTranslations } from '../i18n/get-translations';
const t = getTranslations('en');
---

<Base
  title={t('not_found.seo_title')}
  description={t('not_found.description')}
  noindex={true}
  enableLocaleAlternates={false}
>
  <section class="utility-page">
    <div class="wrap">
      <div class="not-found">
        <p class="eyebrow">404</p>
        <h1 class="d1">{t('not_found.title')}</h1>
        <p class="lead">
          {t('not_found.body')}
        </p>
        <div class="row">
          <a class="btn btn-primary" href="/games">{t('not_found.games')}</a>
          <a class="btn btn-ghost" href={CTA.href}>{t('header.lets_talk')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    display: flex; flex-direction: column; gap: var(--sp-4);
    align-items: flex-start;
  }
  .row { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-3); }
</style>
