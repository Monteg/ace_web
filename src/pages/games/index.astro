---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CatalogueHero from '../../components/showcase/CatalogueHero.astro';
import GameTile from '../../components/showcase/GameTile.astro';
import ContactModal from '../../components/ContactModal.astro';
import { CTA, company } from '../../data/site';
import { CATALOGUE_CATEGORIES } from '../../lib/game-categories';

// /portfolio returned a 404 on the old site: the catalogue existed only as a
// section of the home page and a dropdown listing 17 of 24 titles.
const games = (await getCollection('games')).sort(
  (a, b) =>
    Number(a.data.status === 'coming_soon') - Number(b.data.status === 'coming_soon') ||
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name),
);

const present = CATALOGUE_CATEGORIES.filter((category) => games.some((game) => game.data.type === category.type));

const heroIds = ['way-to-olympus', 'cyber-star', 'pirates-rush', 'ace-city'];
const heroGames = heroIds.flatMap((id) => {
  const game = games.find((entry) => entry.id === id);
  return game ? [game] : [];
});

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ace Games catalogue',
  numberOfItems: games.length,
  itemListElement: games.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.data.name,
    url: `${company.origin}/portfolio/${g.id}`,
  })),
};
---

<Base
  title="Casino games: slots, crash and instant games | Ace Games"
  description={`Explore all ${games.length} Ace Games titles with published RTP, volatility and playable demos where available. Slot, instant and table games for licensed operators.`}
  schema={listSchema}
>
  <CatalogueHero games={heroGames} />

  <section class="catalogue-list">
    <div class="wrap">
      <div class="chips filters" id="games" role="group" aria-label="Filter games by type">
        <button class="chip" type="button" data-filter="all" aria-pressed="true">All</button>
        {present.map(({ type, label }) => (
          <button class="chip" type="button" data-filter={type} aria-pressed="false">
            {label}
          </button>
        ))}
      </div>
      <p class="filter-note" data-filter-note aria-live="polite"></p>

      <div class="grid-games" id="gameGrid">
        {games.map((g, i) => <GameTile game={g} eager={i < 4} />)}
      </div>

      <div class="tail rv">
        <h2 class="d3">Missing a mechanic?</h2>
        <p class="body">
          Tell us what your lobby is short of and we will design the maths around it rather than
          reskinning something we already made.
        </p>
        <button class="btn btn-primary" type="button" data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog" hidden>{CTA.label}</button>
        <noscript><a class="btn btn-primary" href={CTA.href}>{CTA.label}</a></noscript>
      </div>
    </div>
  </section>
  <ContactModal />
</Base>

<style>
  .filters { scroll-margin-top: calc(var(--site-header-height, 120px) + var(--sp-4)); }

  .grid-games { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-4); }
  @media (max-width: 1040px) { .grid-games { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 780px) { .grid-games { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); } }
  @media (max-width: 440px) { .grid-games { grid-template-columns: 1fr; } }
  .filter-note { margin-top: var(--sp-3); margin-bottom: var(--sp-5); font-size: 13px; color: var(--fg-3); }
  .filter-note:empty { margin-top: 0; }
  .grid-games :global(.is-dim) { opacity: 0.38; filter: grayscale(0.7); }
  .grid-games :global(.is-dim:hover) { opacity: 1; filter: none; }

  .tail {
    margin-top: var(--section-space-compact); padding-top: var(--section-space-compact); border-top: 1px solid var(--line);
    display: flex; flex-direction: column; gap: var(--sp-4); align-items: flex-start;
  }
  .tail [hidden] { display: none; }
</style>

<script>
  import { mountCatalogueFilter } from '../../lib/catalogue-filter';
  mountCatalogueFilter('gameGrid', '.filters .chip[data-filter]');
  if (location.hash === '#games') {
    document.fonts.ready.then(() => requestAnimationFrame(() => {
      document.getElementById('games')?.scrollIntoView({ block: 'start', behavior: 'instant' });
    }));
  }
</script>
