---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GameHeader from '../../components/showcase/GameHeader.astro';
import GameMedia from '../../components/showcase/GameMedia.astro';
import SpecStrip from '../../components/showcase/SpecStrip.astro';
import GameTile from '../../components/showcase/GameTile.astro';
import { company } from '../../data/site';
import { demoUrl } from '../../lib/format';
import { localeFromPath, localizePath, lowerTypeLabel, t } from '../../lib/i18n';
import { getLocalizedGame, renderManagedMarkdown } from '../../lib/localized-games';
import { getSiteContent } from '../../lib/site-content';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game, all: games } }));
}

const { game, all } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
const d = getLocalizedGame(game, locale);
const { CTA } = getSiteContent(locale);

const soon = d.status === 'coming_soon';
const demo = d.demo ? demoUrl(d.demo, game.id, company.origin) : null;

const related = all
  .filter((g) => g.id !== game.id && g.data.type === d.type && g.data.status === 'live')
  .slice(0, 3);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  brand: { '@type': 'Brand', name: company.name },
  category: `${t(`global.game_type.${d.type}_single`, locale)} game`,
  description: d.seo.description,
  url: `${company.origin}${localizePath(`/portfolio/${game.id}`, locale)}`,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('game.detail.breadcrumb.games', locale), item: `${company.origin}${localizePath('/games', locale)}` },
    { '@type': 'ListItem', position: 2, name: d.name, item: `${company.origin}${localizePath(`/portfolio/${game.id}`, locale)}` },
  ],
};
const bodySections = [
  { title: '', body: d.overview },
  { title: t('game.detail.core_gameplay', locale), body: d.gameplay },
  { title: d.mainFeatureLabel || t('global.label.main_feature', locale), body: d.mainFeatureBody },
  { title: t('game.detail.bonus', locale), body: d.bonus },
  { title: t('game.detail.multiplier', locale), body: d.multiplier },
  { title: t('game.detail.design', locale), body: d.designAtmosphere },
].filter((section) => section.body.trim());
---

<Base title={d.seo.title} description={d.seo.description} schema={[productSchema, breadcrumbSchema]}>
  <GameHeader game={game} demoAvailable={demo !== null} />

  <section id="demo" class="game-media-section">
    <div class="wrap">
      <div class="media-layout">
        <div class="media-main rv">
          <GameMedia
            id={game.id}
            name={d.name}
            demoSrc={demo}
            poster={d.hero}
            gallery={d.gallery}
            posterAlt={d.heroAlt}
          />

          {!demo && (
            <div class="demo-request">
              <div>
                <h2 class="d3">{soon ? t('game.detail.in_development', locale) : t('game.detail.demo_on_request', locale)}</h2>
                <p class="body">
                  {soon
                    ? t('game.detail.unreleased_body', locale, { name: d.name })
                    : t('game.detail.demo_request_body', locale, { name: d.name })}
                </p>
              </div>
              <a class="btn btn-primary btn-sm" href={CTA.href}>{CTA.label}</a>
            </div>
          )}
        </div>

        <aside class="spec-sidebar rv" aria-label={t('game.detail.specs_aria', locale, { name: d.name })}>
          <h2 class="d3">{t('game.detail.specs', locale)}</h2>
          <SpecStrip game={game} variant="sidebar" />
        </aside>
      </div>
    </div>
  </section>

  <section class="section-continuation">
    <div class="wrap">
      <div class="over">
        <div class="over-copy">
          <div class="sec-top rv"><h2 class="d1">{t('game.detail.overview', locale)}</h2></div>
          <div class="prose rv">
            {bodySections.map((section) => (
              <section>
                {section.title && <h2>{section.title}</h2>}
                <div set:html={renderManagedMarkdown(section.body)} />
              </section>
            ))}
          </div>
          {d.highlights.length > 0 && (
            <ul class="highlights rv">
              {d.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )}
        </div>
        {d.features.length > 0 && (
          <aside class="over-side rv">
            <h3 class="d3">{t('game.detail.features', locale)}</h3>
            <ol class="feats">
              {d.features.map((f) => (
                <li>
                  <h4 class="d4">{f.title}</h4>
                  <p>{f.body}</p>
                </li>
              ))}
            </ol>
          </aside>
        )}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-continuation">
      <div class="wrap">
        <div class="sec-top rv"><h2 class="d1">{t('game.detail.more_games', locale, { type: lowerTypeLabel(d.type, locale) })}</h2></div>
        <div class="related rv">
          {related.map((g) => <GameTile game={g} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .game-media-section {
    padding-block: clamp(48px, 6vw, 84px) var(--section-space);
  }
  .media-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }
  .media-main { min-width: 0; }
  .spec-sidebar {
    position: sticky;
    top: calc(var(--site-header-height, 120px) + var(--sp-4));
    min-width: 0;
  }
  .spec-sidebar > .d3 { margin-bottom: var(--sp-4); }
  .demo-request {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    margin-top: var(--sp-4);
    padding: var(--sp-5);
    background: var(--ink-2);
    border: 1px dashed var(--line-2);
    border-radius: var(--radius-l);
  }
  .demo-request > div {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .over {
    display: grid;
    grid-template-columns: minmax(0, 800px) minmax(280px, 360px);
    justify-content: space-between;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .over-copy { min-width: 0; max-width: 800px; }
  .prose { max-width: 72ch; display: flex; flex-direction: column; gap: var(--sp-4); }
  .prose :global(p) { color: var(--fg-2); }
  .prose :global(h2) {
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-weight: 400;
    font-size: var(--step-2); line-height: 1.05; color: var(--fg); margin: var(--sp-5) 0 0;
  }
  .highlights { list-style: none; margin-top: var(--sp-6); display: grid; gap: var(--sp-3); }
  .highlights li { position: relative; padding-left: var(--sp-5); font-size: 14.5px; color: var(--fg-2); line-height: 1.5; }
  .highlights li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; border-radius: 2px; background: var(--brand); }

  .over-side {
    position: sticky;
    top: calc(var(--site-header-height, 120px) + var(--sp-4));
    background: var(--ink-2);
    border-radius: var(--radius-l);
    padding: var(--sp-6);
    box-shadow: var(--shadow-1);
  }
  .feats { list-style: none; margin-top: var(--sp-5); display: flex; flex-direction: column; }
  .feats li { padding: var(--sp-4) 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .feats p { font-size: 14px; color: var(--fg-2); line-height: 1.5; }

  .related { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-4); }
  @media (max-width: 992px) {
    .media-layout,
    .over { grid-template-columns: minmax(0, 1fr); }
    .spec-sidebar,
    .over-side { position: static; }
  }
  @media (max-width: 640px) {
    .demo-request { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 760px) { .related { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 440px) { .related { grid-template-columns: 1fr; } }
</style>
