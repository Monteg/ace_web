---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GameHeader from '../../components/showcase/GameHeader.astro';
import GameMedia from '../../components/showcase/GameMedia.astro';
import GameTile from '../../components/showcase/GameTile.astro';
import { company } from '../../data/site';
import { demoUrl } from '../../lib/format';
import { localeFromPath, localizePath, lowerTypeLabel, t } from '../../lib/i18n';
import { getLocalizedGame, renderManagedMarkdown } from '../../lib/localized-games';
import { getSiteContent } from '../../lib/site-content';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game, all: games } }));
}

const { game, all } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
const d = getLocalizedGame(game, locale);
const { CTA } = getSiteContent(locale);
const soon = d.status === 'coming_soon';
const demo = d.demo ? demoUrl(d.demo, game.id, company.origin) : null;

const related = all
  .filter((entry) => entry.id !== game.id && entry.data.type === d.type && entry.data.status === 'live')
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name))
  .slice(0, 4);

const tabSections = [
  { id: 'core-gameplay', title: t('game.detail.core_gameplay', locale), body: d.gameplay },
  { id: 'main-feature', title: d.mainFeatureLabel || t('global.label.main_feature', locale), body: d.mainFeatureBody },
  { id: 'bonus', title: t('game.detail.bonus', locale), body: d.bonus },
  { id: 'multiplier', title: t('game.detail.multiplier', locale), body: d.multiplier },
  { id: 'design', title: t('game.detail.design', locale), body: d.designAtmosphere },
].filter((section) => section.body.trim());

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  brand: { '@type': 'Brand', name: company.name },
  category: `${t(`global.game_type.${d.type}_single`, locale)} game`,
  description: d.seo.description,
  url: `${company.origin}${localizePath(`/portfolio/${game.id}`, locale)}`,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('game.detail.breadcrumb.games', locale), item: `${company.origin}${localizePath('/games', locale)}` },
    { '@type': 'ListItem', position: 2, name: d.name, item: `${company.origin}${localizePath(`/portfolio/${game.id}`, locale)}` },
  ],
};
---

<Base title={d.seo.title} description={d.seo.description} schema={[productSchema, breadcrumbSchema]}>
  <GameHeader game={game} demoAvailable={demo !== null} />

  <section id="demo" class="game-detail-section">
    <div class="wrap">
      <div class:list={['media-layout', { 'media-layout--solo': d.features.length === 0 }]}>
        <div class="media-main rv">
          <GameMedia
            id={game.id}
            name={d.name}
            demoSrc={demo}
            poster={d.hero}
            gallery={d.gallery}
            posterAlt={d.heroAlt}
          />

          {!demo && (
            <div class="demo-request">
              <div>
                <h2 class="d3">{soon ? t('game.detail.in_development', locale) : t('game.detail.demo_on_request', locale)}</h2>
                <p class="body">
                  {soon
                    ? t('game.detail.unreleased_body', locale, { name: d.name })
                    : t('game.detail.demo_request_body', locale, { name: d.name })}
                </p>
              </div>
              <a class="btn btn-primary btn-sm" href={CTA.href}>{CTA.label}</a>
            </div>
          )}
        </div>

        {d.features.length > 0 && (
          <aside class="feature-panel rv" aria-labelledby={`${game.id}-features-title`}>
            <h2 id={`${game.id}-features-title`} class="d2">{t('game.detail.features', locale)}</h2>
            <ol class="feature-list">
              {d.features.map((feature) => (
                <li>
                  <h3 class="d4">{feature.title}</h3>
                  <p>{feature.body}</p>
                </li>
              ))}
            </ol>
          </aside>
        )}

        <div class="overview-content">
          <div class="overview-heading rv">
            <h2 class="d2">{t('game.detail.overview', locale)}</h2>
            <div class="overview-intro" set:html={renderManagedMarkdown(d.overview)} />
          </div>

          {tabSections.length > 0 && (
            <div class="overview-tabs rv" data-overview-tabs>
              <div class="tab-list" role="tablist" aria-label={t('game.detail.overview_tabs_aria', locale)}>
                {tabSections.map((section, index) => (
                  <button
                    id={`${game.id}-${section.id}-tab`}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-controls={`${game.id}-${section.id}-panel`}
                    tabindex={index === 0 ? 0 : -1}
                    data-overview-tab={section.id}
                  >
                    {section.title}
                  </button>
                ))}
              </div>

              <div class="tab-panels">
                {tabSections.map((section) => (
                  <section
                    id={`${game.id}-${section.id}-panel`}
                    role="tabpanel"
                    aria-labelledby={`${game.id}-${section.id}-tab`}
                    data-overview-panel={section.id}
                  >
                    <h3 class="d3 tab-fallback-title">{section.title}</h3>
                    <div class="tab-copy" set:html={renderManagedMarkdown(section.body)} />
                  </section>
                ))}
              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related-section">
      <div class="wrap related-wrap">
        <div class="related-heading rv">
          <h2 class="d1">{t('game.detail.more_games', locale, { type: lowerTypeLabel(d.type, locale) })}</h2>
        </div>
        <div class="related-grid rv" aria-label={t('game.detail.related_aria', locale)}>
          {related.map((entry) => <GameTile game={entry} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .game-detail-section {
    overflow: clip;
    padding-block: clamp(36px, 4vw, 64px) clamp(20px, 2.5vw, 32px);
    background: var(--ink-1);
  }
  .media-layout {
    display: grid;
    grid-template-columns: minmax(0, 2.08fr) minmax(280px, 0.92fr);
    grid-template-areas:
      'media features'
      'overview features';
    column-gap: clamp(18px, 2vw, 28px);
    row-gap: 0;
    align-items: start;
  }
  .media-layout--solo {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'media'
      'overview';
  }
  .media-main { grid-area: media; min-width: 0; }
  .feature-panel {
    grid-area: features;
    position: sticky;
    top: calc(var(--site-header-height, 120px) + var(--sp-4));
    min-width: 0;
    padding: clamp(var(--sp-5), 3vw, var(--sp-6));
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-1);
  }
  .feature-panel > .d2 { font-size: clamp(2rem, 3vw, 2.8rem); }
  .feature-list { display: flex; flex-direction: column; margin-top: var(--sp-5); list-style: none; }
  .feature-list li {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding-block: var(--sp-4);
    border-top: 1px solid var(--line);
  }
  .feature-list .d4 { font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.08; }
  .feature-list p { margin: 0; color: var(--fg-2); font-size: 13px; line-height: 1.55; }
  .demo-request {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    margin-top: var(--sp-4);
    padding: var(--sp-5);
    background: var(--ink-2);
    border: 1px dashed var(--line-2);
    border-radius: var(--radius-l);
  }
  .demo-request > div { display: flex; min-width: 0; flex-direction: column; gap: var(--sp-2); }

  .overview-content {
    grid-area: overview;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: clamp(18px, 2vw, 28px);
    padding-top: clamp(12px, 1.5vw, 20px);
  }
  .overview-heading { display: flex; min-width: 0; flex-direction: column; gap: var(--sp-3); }
  .overview-heading .d2 { font-size: clamp(1.65rem, 2.2vw, 2.25rem); line-height: 0.98; }
  .overview-intro { max-width: 70ch; color: var(--fg-2); font-size: clamp(0.94rem, 1.15vw, 1.04rem); line-height: 1.62; }
  .overview-intro :global(p) { margin: 0; }
  .overview-tabs { min-width: 0; }
  .tab-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 6px;
    max-width: 100%;
    overflow: visible;
  }
  .tab-list button {
    position: relative;
    min-width: 0;
    min-height: 58px;
    padding: 11px clamp(10px, 1.2vw, 16px);
    color: color-mix(in srgb, var(--fg) 68%, var(--fg-2));
    background: color-mix(in srgb, var(--ink-2) 90%, transparent);
    border: 0;
    border-radius: var(--radius-s);
    cursor: pointer;
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif;
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.08;
    text-transform: uppercase;
    white-space: normal;
    transition: color var(--dur-1), background-color var(--dur-1);
  }
  .tab-list button::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-2) var(--ease);
  }
  .tab-list button:hover { color: var(--fg); background: color-mix(in srgb, var(--ink-3) 72%, transparent); }
  .tab-list button[aria-selected='true'] { color: var(--fg); background: var(--ink-2); }
  .tab-list button[aria-selected='true']::after { transform: scaleX(1); }
  .tab-panels { max-width: 78ch; min-height: 118px; padding: var(--sp-4) 0 0; }
  .tab-panels > section { padding-block: var(--sp-3); }
  .tab-fallback-title { margin-bottom: var(--sp-3); }
  .overview-tabs.is-enhanced .tab-panels > section { padding-block: 0; }
  .overview-tabs.is-enhanced .tab-fallback-title { display: none; }
  .overview-tabs.is-enhanced [data-overview-panel][hidden] { display: none; }
  .tab-copy { color: color-mix(in srgb, var(--fg) 72%, var(--fg-2)); font-size: clamp(15.5px, 1vw, 16.5px); line-height: 1.62; }
  .tab-copy :global(p) { margin: 0; }
  .tab-copy :global(p + p) { margin-top: var(--sp-3); }

  .related-section {
    overflow: visible;
    padding-block: clamp(20px, 2vw, 28px) clamp(56px, 7vw, 96px);
    background: linear-gradient(90deg, var(--ink-0), var(--ink-1));
  }
  .related-heading { margin-bottom: var(--sp-5); }
  .related-heading .d1 { font-size: clamp(1.85rem, 2.55vw, 2.65rem); line-height: 0.98; }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(12px, 1.35vw, 18px);
    padding-block: 10px var(--sp-3);
    overflow: visible;
  }

  @media (max-width: 1080px) {
    .media-layout { grid-template-columns: minmax(0, 1.65fr) minmax(260px, 0.85fr); }
    .tab-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .related-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .media-layout,
    .media-layout--solo {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'media'
        'features'
        'overview';
    }
    .media-layout--solo { grid-template-areas: 'media' 'overview'; }
    .feature-panel { position: static; }
    .overview-content { padding-top: var(--sp-3); }
    .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .game-detail-section { padding-top: var(--sp-5); }
    .feature-panel { padding: var(--sp-5); }
    .demo-request { align-items: flex-start; flex-direction: column; }
    .overview-heading .d2 { font-size: clamp(1.65rem, 7vw, 2rem); }
    .tab-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px; }
    .tab-list button { min-height: 58px; padding-inline: 10px; font-size: clamp(0.95rem, 4.4vw, 1.08rem); }
    .tab-list button:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .tab-panels { min-height: 132px; padding-top: var(--sp-4); }
    .related-heading .d1 { font-size: clamp(1.8rem, 8.5vw, 2.2rem); }
  }
  @media (max-width: 440px) { .related-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) {
    .tab-list button::after { transition: none; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-overview-tabs]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-overview-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-overview-panel]'));
    if (!tabs.length || !panels.length) continue;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const activate = (tab: HTMLButtonElement, focus = false) => {
      const id = tab.dataset.overviewTab;
      tabs.forEach((candidate) => {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => {
        const selected = panel.dataset.overviewPanel === id;
        panel.hidden = !selected;
        if (selected && !reduceMotion.matches) {
          panel.animate(
            [
              { opacity: 0, transform: 'translateY(7px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 260, easing: 'cubic-bezier(0.32, 0.72, 0, 1)' },
          );
        }
      });
      if (focus) tab.focus({ preventScroll: true });
    };

    root.classList.add('is-enhanced');
    activate(tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') ?? tabs[0]);

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[nextIndex], true);
      });
    });
  }
</script>
