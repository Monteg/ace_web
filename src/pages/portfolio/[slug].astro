---
import Base from '../../layouts/Base.astro';
import GameHeader from '../../components/showcase/GameHeader.astro';
import GameMedia from '../../components/showcase/GameMedia.astro';
import SpecStrip from '../../components/showcase/SpecStrip.astro';
import GameFeatureSidebar from '../../components/showcase/GameFeatureSidebar.astro';
import GameOverview from '../../components/showcase/GameOverview.astro';
import GameContentTabs from '../../components/showcase/GameContentTabs.astro';
import GameSections from '../../components/showcase/GameSections.astro';
import RelatedGamesRail from '../../components/showcase/RelatedGamesRail.astro';
import GameFeedbackCTA from '../../components/showcase/GameFeedbackCTA.astro';
import { company } from '../../data/site';
import { demoUrl } from '../../lib/format';
import { buildGameDetailViewModel, getGames } from '../../lib/content-source';
import { getTranslations } from '../../i18n/get-translations';
import { getActiveLocales } from '../../i18n/config';
import { localePath } from '../../i18n/routes';
import { isCmsLiveMode } from '../../lib/cms-mode';

interface Props {
  game?: Awaited<ReturnType<typeof getGames>>[number];
  all?: Awaited<ReturnType<typeof getGames>>;
  locale?: string;
  slug?: string;
}

export const prerender = !isCmsLiveMode();

export async function getStaticPaths() {
  const games = await getGames('en');
  return games.map((game) => ({ params: { slug: game.id }, props: { game, all: games, locale: 'en' } }));
}

const locale = Astro.props.locale ?? 'en';
const all = Astro.props.all ?? await getGames(locale);
const game = Astro.props.game ?? all.find((entry) => entry.id === (Astro.props.slug ?? Astro.params.slug));
if (!game) return Astro.redirect('/404');
const t = await getTranslations(locale);
const locales = await getActiveLocales();
const detail = buildGameDetailViewModel(game, all);
const d = game.data;
const soon = d.status === 'coming_soon';
const demo = detail.media.demo ? demoUrl(detail.media.demo, game.id, company.origin) : null;
const typeLabel = t(`game.type.${d.type}`);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  brand: { '@type': 'Brand', name: company.name },
  category: `${typeLabel} game`,
  description: d.seo.description,
  url: new URL(localePath(`/portfolio/${game.id}`, locale, locales), company.origin).href,
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('header.games'), item: new URL(localePath('/games', locale, locales), company.origin).href },
    { '@type': 'ListItem', position: 2, name: d.name, item: new URL(localePath(`/portfolio/${game.id}`, locale, locales), company.origin).href },
  ],
};
---

<Base title={d.seo.title} description={d.seo.description} schema={[productSchema, breadcrumbSchema]} locale={locale}>
  <GameHeader game={game} demoAvailable={demo !== null} locale={locale} />

  <section class="game-detail-stats" aria-label={t('game.specifications_aria', { name: d.name })}>
    <div class="wrap"><SpecStrip game={game} locale={locale} /></div>
  </section>

  <div class="game-detail-main" id="demo">
    <div class="wrap">
      <div class:list={['game-detail-grid', { 'game-detail-grid--wide': detail.featureGroups.length === 0 }]}>
        <div class="game-detail-media rv">
          <GameMedia
            id={game.id}
            name={d.name}
            demoSrc={demo}
            poster={detail.media.fallback}
            gallery={detail.media.gallery}
            locale={locale}
          />

          {!demo && (
            <div class="demo-request">
              <div>
                <h2 class="d3">{soon ? t('game.status.in_development') : t('game.demo_request')}</h2>
                <p>
                  {soon
                    ? t('game.demo_request_soon', { name: d.name })
                    : t('game.demo_request_live', { name: d.name })}
                </p>
              </div>
              <button class="btn btn-primary btn-sm" type="button" data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog" hidden>{t('header.lets_talk')}</button>
              <noscript><a class="btn btn-primary btn-sm" href={`${localePath('/', locale, locales)}#contact`}>{t('header.lets_talk')}</a></noscript>
            </div>
          )}
        </div>

        {detail.featureGroups.length > 0 && (
          <div class="game-detail-features rv">
            <div class="game-detail-features__sticky">
              <GameFeatureSidebar groups={detail.featureGroups} locale={locale} />
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <GameOverview markdown={detail.overviewMarkdown} locale={locale} />
  <GameContentTabs id={game.id} gameName={d.name} tabs={detail.tabs} locale={locale} />

  {detail.additionalSections.length > 0 && (
    <section class="game-detail-additional">
      <div class="wrap"><GameSections sections={detail.additionalSections} /></div>
    </section>
  )}

  <RelatedGamesRail games={detail.relatedGames} typeLabel={typeLabel} locale={locale} />
  <GameFeedbackCTA name={d.name} contactHref={`${localePath('/', locale, locales)}#contact`} locale={locale} />
</Base>

<style>
  .game-detail-stats {
    padding-block: var(--sp-4) var(--sp-6);
    background: var(--ink-0);
  }
  .game-detail-main { padding-block: 0 var(--section-space-compact); }
  .game-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(260px, 0.8fr);
    align-items: start;
    gap: clamp(20px, 2.5vw, 36px);
  }
  .game-detail-grid--wide { grid-template-columns: minmax(0, 1fr); }
  .game-detail-media,
  .game-detail-features { min-width: 0; }
  .game-detail-features__sticky {
    position: sticky;
    top: calc(var(--site-header-height, 120px) + var(--sp-4));
  }
  .demo-request {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    margin-top: var(--sp-4);
    padding: var(--sp-5);
    background: var(--ink-2);
    border: 1px dashed var(--line-2);
    border-radius: var(--radius-l);
  }
  .demo-request > div { display: grid; min-width: 0; gap: var(--sp-2); }
  .demo-request p { max-width: 58ch; color: var(--fg-2); font-size: 14px; }
  .game-detail-additional { padding-block: 0 var(--section-space-compact); }

  @media (max-width: 900px) {
    .game-detail-grid { grid-template-columns: minmax(0, 1fr); }
    .game-detail-features__sticky { position: static; }
  }
  @media (max-width: 600px) {
    .game-detail-stats { padding-block: var(--sp-3) var(--sp-5); }
    .game-detail-main { padding-bottom: var(--sp-7); }
    .demo-request { align-items: flex-start; flex-direction: column; padding: var(--sp-4); }
    .demo-request .btn { width: 100%; }
  }
</style>
