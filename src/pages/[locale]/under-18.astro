---
import Under18Page from '../under-18.astro';
import { getActiveLocales, defaultLocale } from '../../i18n/config';

export function getStaticPaths() {
  return getActiveLocales().filter((item) => item.code !== defaultLocale).map((item) => ({ params: { locale: item.code }, props: { locale: item.code } }));
}
const { locale } = Astro.props;
---
<Under18Page locale={locale} />
