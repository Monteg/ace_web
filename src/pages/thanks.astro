---
import Base from '../layouts/Base.astro';
import { company, CTA } from '../data/site';
import { getTranslations } from '../i18n/get-translations';
export const prerender = true;
const t = await getTranslations('en');

// The form redirects here. A real page, not a hidden div swap, so a submission
// is a URL you can count as a conversion.
//
// The site is static, so the query string is not visible at build time: both
// states are rendered and a few lines of script pick one. The success state is
// the default, so a script failure shows the reassuring message rather than an
// error the visitor cannot act on.
const REASONS: Record<string, string> = {
  invalid: 'Some fields were missing, or the email address did not look right.',
  unconfigured: 'The contact form is not connected to an inbox yet.',
  'send-failed': 'The message could not be delivered just now.',
  unreadable: 'The form could not be read.',
};
---

<Base
  title={t('thanks.seo_title')}
  description={t('thanks.description')}
  noindex={true}
  enableLocaleAlternates={false}
>
  <section class="utility-page">
    <div class="wrap">
      <div class="panel" data-state="ok">
        <p class="eyebrow" data-eyebrow>{t('thanks.eyebrow')}</p>
        <h1 class="d1" data-title>{t('thanks.heading')}</h1>
        <p class="lead" data-body>
          {t('thanks.body')}
        </p>

        <div class="row">
          <a class="btn btn-primary" href={`mailto:${company.email}`}>{company.email}</a>
          <a class="btn btn-ghost" data-second href="/games">{t('thanks.games')}</a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="failure-copy" is:inline set:html={JSON.stringify(REASONS)} />

  <script is:inline define:vars={{ ctaHref: CTA.href }}>
    const params = new URLSearchParams(window.location.search);
    if (params.get('status') === 'error') {
      const reasons = JSON.parse(document.getElementById('failure-copy').textContent);
      const reason = reasons[params.get('reason') ?? ''] ?? 'Something went wrong on the way.';

      document.querySelector('[data-eyebrow]').textContent = 'Not sent';
      document.querySelector('[data-title]').textContent = 'That did not send';
      document.querySelector('[data-body]').textContent =
        `${reason} Mail us directly and we will pick it up from there.`;

      const second = document.querySelector('[data-second]');
      second.textContent = 'Back to the form';
      second.href = ctaHref;

      document.title = 'That did not send | Ace Games';
    }
  </script>
</Base>

<style>
  .panel {
    display: flex; flex-direction: column; gap: var(--sp-4);
    align-items: flex-start; max-width: 60ch;
  }
  .row { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-3); }
</style>
