---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { company } from '../data/site';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map((doc) => ({ params: { legal: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Base
  title={`${doc.data.title} | Ace Games`}
  description={`${doc.data.title} for acegames.io, operated by ${company.legalName}, a business-to-business developer of online gaming content. Last updated ${doc.data.updated}.`}
>
  <section>
    <div class="wrap">
      <header class="head">
        <h1 class="d1">{doc.data.title}</h1>
        <p class="upd">Last updated {doc.data.updated}</p>
      </header>
      <div class="doc"><Content /></div>
    </div>
  </section>
</Base>

<style>
  .head { margin-bottom: var(--sp-7); }
  .head .d1 { font-size: clamp(2.2rem, 4.6vw, 3.4rem); }
  .upd {
    margin-top: var(--sp-3); font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12px; color: var(--fg-3);
  }
  .doc { max-width: 72ch; color: var(--fg-2); }
  .doc :global(h2),
  .doc :global(h3) {
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-weight: 400;
    color: var(--fg); line-height: 1.1; margin: var(--sp-7) 0 var(--sp-3);
  }
  .doc :global(h2) { font-size: var(--step-2); }
  .doc :global(h3) { font-size: var(--step-1); }
  .doc :global(p) { margin-bottom: var(--sp-4); line-height: 1.7; }
  .doc :global(ul) { margin: 0 0 var(--sp-4) var(--sp-5); }
  .doc :global(li) { margin-bottom: var(--sp-2); line-height: 1.6; }
  .doc :global(a) { color: var(--peach); }
</style>
