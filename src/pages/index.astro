---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ContactForm from '../components/ContactForm.astro';
import Base from '../layouts/Base.astro';
import Wall from '../components/showcase/Wall.astro';
import GameTile from '../components/showcase/GameTile.astro';
import StatTile from '../components/StatTile.astro';
import Excellence from '../components/showcase/Excellence.astro';
import Craft from '../components/showcase/Craft.astro';
import FutureOfGaming from '../components/showcase/FutureOfGaming.astro';
import PartnerWall from '../components/showcase/PartnerWall.astro';
import MathsExplorer from '../components/showcase/MathsExplorer.astro';
import contactPigeon from '../assets/site/contact-pigeon-v3.png';
import { homepageSections, partners } from '../data/site';
import { CATALOGUE_CATEGORIES } from '../lib/game-categories';
import { localeFromPath, localizePath, t } from '../lib/i18n';
import { getSiteContent } from '../lib/site-content';

const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
const { faq, heroStats, proofIntro, sectionCopy, integration } = getSiteContent(locale);

const games = (await getCollection('games')).sort(
  (a, b) =>
    Number(a.data.status === 'coming_soon') - Number(b.data.status === 'coming_soon') ||
    a.data.order - b.data.order ||
    a.data.name.localeCompare(b.data.name),
);
const mathsGames = games.filter(
  (game) => game.data.status === 'live' && typeof game.data.specs.rtp === 'number',
);

const present = CATALOGUE_CATEGORIES
  .filter((category) => games.some((game) => game.data.type === category.type))
  .map((category) => ({ ...category, label: t(`global.game_type.${category.type}`, locale) }));

const contactTitleWords = sectionCopy.contactTitle.trim().split(/\s+/);
const contactTitleLead = contactTitleWords.shift() ?? '';
const contactTitleAccent = contactTitleWords.pop() ?? '';
const contactTitleMiddle = contactTitleWords.join(' ');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq
    .filter((f) => f.a)
    .map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title={t('home.seo.title', locale)}
  description={t('home.seo.description', locale)}
  schema={faqSchema}
>
  <Wall games={games} />

  <!-- ============ proof ============ -->
  <section class="proof cream" id="about-us" aria-labelledby="proof-title">
    <div class="wrap">
      <h2 id="proof-title" class="proof-intro rv">{proofIntro}</h2>
      <div class="proof-in rv">
        {heroStats.map((s) => <StatTile {...s} />)}
      </div>
    </div>
  </section>

  <Excellence />

  <!-- ============ portfolio ============ -->
  <section id="games">
    <div class="wrap">
      <div class="sec-top home-section-heading rv">
        <h2 class="d1">{sectionCopy.portfolioTitle}</h2>
      </div>

      <div class="portfolio-controls rv">
        <div class="chips" role="group" aria-label={t('catalogue.filter_aria', locale)}>
          <button class="chip" type="button" data-filter="all" aria-pressed="true">{t('global.filter.all', locale)}</button>
          {present.map(({ type, label }) => (
            <button class="chip" type="button" data-filter={type} aria-pressed="false">{label}</button>
          ))}
        </div>
        <a class="btn btn-ghost see-all" href={localizePath('/games', locale)}>
          {t('global.action.view_games', locale)}
          <span class="disc" aria-hidden="true"><Icon name="ph:arrow-right" /></span>
        </a>
      </div>

      <p class="filter-note" data-filter-note aria-live="polite"></p>
      <div class="cat rv" id="gameGrid">
        {games.map((g, i) => <GameTile game={g} eager={i < 4} />)}
      </div>
      <script is:inline>
        document.getElementById('gameGrid')?.setAttribute('data-progressive-ready', '');
      </script>
      <div class="load-games-row" data-load-games-row hidden>
        <button class="btn btn-ghost see-all load-games" type="button" data-load-games>
          {t('global.action.load_games', locale)}
          <span class="disc" aria-hidden="true"><Icon name="ph:arrow-down" /></span>
        </button>
      </div>
    </div>
  </section>

  <!-- ============ maths explorer ============ -->
  <section id="maths" class="section-continuation">
    <div class="wrap">
      <div class="sec-top home-section-heading rv">
        <h2 class="d1">{t('home.maths.title', locale)}</h2>
        <p class="lead">{t('home.maths.lead', locale)}</p>
      </div>
      <div class="rv">
        <MathsExplorer games={mathsGames}>
          <Fragment slot="caption">{t('home.maths.caption', locale)}</Fragment>
        </MathsExplorer>
      </div>
    </div>
  </section>

  {homepageSections.craft && <Craft />}

  <FutureOfGaming />

  <PartnerWall logos={partners} />

  <!-- ============ integration and compliance ============ -->
  {homepageSections.integration && (
  <section id="integration">
    <div class="wrap">
      <div class="sec-top rv">
        <h2 class="d1">{t('home.integration.title', locale)}</h2>
        <p class="lead">{t('home.integration.lead', locale)}</p>
      </div>
      <div class="groups rv">
        {integration.map((g) => (
          <section class="group">
            <div class="group-head">
              <span class={`tile tile--${g.tint}`} aria-hidden="true"><Icon name={g.icon} /></span>
              <h3 class="d3">{g.title}</h3>
            </div>
            <dl>
              {g.rows.map((r) => (
                <div class="row">
                  <dt>{r.label}</dt>
                  <dd>{r.value ? r.value : <span class="need">{r.hint}</span>}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ============ faq ============ -->
  <section id="faq">
    <div class="wrap">
      <div class="sec-top home-section-heading rv"><h2 class="d1">{t('home.faq.title', locale)}</h2></div>
      <div class="faq rv">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>
              <span class="faq-question">{f.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="answer">
              <div class="answer-in">
                {f.a ? <p>{f.a}</p> : <p><span class="need">{f.hint}</span></p>}
                {f.extra && <p>{f.extra}</p>}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ contact ============ -->
  <section id="contact" class="contact-section">
    <Image
      class="contact-backdrop"
      src={contactPigeon}
      alt=""
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      loading="lazy"
      quality={84}
    />
    <div class="wrap contact-shell">
      <div class="contact-grid">
        <div class="contact-copy rv">
          <h2 class="contact-title">
            <span>{contactTitleLead}</span>
            <span>{contactTitleMiddle}</span>
            <strong>{contactTitleAccent}</strong>
          </h2>
        </div>

        <div class="contact-form-placement rv"><ContactForm /></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .proof {
    padding-block: var(--section-space-compact);
    background: var(--cream);
    color: var(--cream-ink);
    border-block: 1px solid var(--cream-line);
  }
  .proof-intro {
    max-width: 1040px;
    margin-inline: auto;
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif;
    font-size: clamp(1.55rem, 1.75vw, 1.85rem);
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-align: center;
    text-transform: uppercase;
    color: var(--cream-ink);
  }
  .proof-in {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(28px, 4vw, 72px);
    margin-top: var(--section-space-compact);
  }
  @media (max-width: 900px) {
    .proof-intro { max-width: 720px; }
    .proof-in {
      max-width: 720px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: clamp(52px, 8vw, 72px);
      margin-inline: auto;
    }
  }
  @media (max-width: 420px) {
    .proof-intro { font-size: clamp(1.4rem, 6.4vw, 1.6rem); }
    .proof-in { column-gap: var(--sp-5); }
  }

  /* portfolio preview */
  .portfolio-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4) var(--sp-5);
    margin-bottom: var(--sp-5);
  }
  .portfolio-controls .chips { min-width: 0; }
  .portfolio-controls .chip { flex-shrink: 0; }
  .see-all {
    flex-shrink: 0; margin-left: auto;
    min-height: 44px; padding: 11px 18px; border-width: 1px;
    font-family: inherit; font-size: 13.5px; font-weight: 500;
    line-height: 1.6; letter-spacing: var(--button-label-spacing);
  }
  .see-all .disc { width: 20px; height: 20px; margin-right: 0; }
  .see-all .disc svg { width: 12px; height: 12px; }
  .cat { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-4); }
  .cat[data-progressive-ready]:not([data-progressive-managed]) > :nth-child(n + 13),
  .cat[data-progressive-managed] > :global(.is-progressive-hidden) { display: none; }
  .load-games-row {
    display: flex;
    justify-content: center;
    margin-top: var(--sp-6);
  }
  .load-games-row[hidden] { display: none; }
  .load-games { margin-inline: auto; }
  @media (max-width: 1100px) { .cat { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 1100px) {
    .cat[data-progressive-ready]:not([data-progressive-managed]) > :nth-child(n + 10) { display: none; }
  }
  @media (max-width: 768px) {
    .cat { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3); }
    .cat[data-progressive-ready]:not([data-progressive-managed]) > :nth-child(n + 7) { display: none; }
    .portfolio-controls .chips { flex-basis: 100%; }
  }
  @media (max-width: 440px) {
    .cat { grid-template-columns: 1fr; }
    .cat[data-progressive-ready]:not([data-progressive-managed]) > :nth-child(n + 4) { display: none; }
    .see-all { width: 100%; }
    .load-games { width: auto; }
  }
  .filter-note { margin-bottom: var(--sp-5); font-size: 13px; color: var(--fg-3); }
  .filter-note:empty { display: none; }
  .cat :global(.is-dim) { opacity: 0.38; filter: grayscale(0.7); }
  .cat :global(.is-dim:hover) { opacity: 1; filter: none; }

  /* integration */
  .groups {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-4);
  }
  @media (max-width: 900px) { .groups { grid-template-columns: 1fr; } }
  .group { background: var(--ink-2); border-radius: var(--radius-l); padding: var(--sp-6) var(--sp-5); box-shadow: var(--shadow-1); }
  .group-head { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .group dl { margin: 0; display: flex; flex-direction: column; gap: var(--sp-4); }
  .row dt {
    font-family: 'JetBrains Mono Variable', monospace; font-size: 10.5px;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-3); margin-bottom: 3px;
  }
  .row dd { margin: 0; font-size: 14.5px; color: var(--fg); line-height: 1.45; }

  /* faq */
  .faq {
    --faq-duration: 300ms;
    display: grid;
    width: 100%;
    gap: var(--sp-3);
  }
  .faq details {
    overflow: clip;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-1);
    transition:
      background-color var(--faq-duration) var(--ease),
      border-color var(--faq-duration) var(--ease);
  }
  .faq details:hover { border-color: var(--line-2); }
  .faq details[open] { background: var(--ink-3); border-color: var(--brand-deep); }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    min-height: 72px;
    padding: var(--sp-5);
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif;
    font-size: var(--step-1);
    line-height: 1.25;
    color: var(--fg);
    border-bottom: 1px solid transparent;
    transition: border-color var(--faq-duration) var(--ease);
  }
  .faq details[open] summary { border-color: var(--line); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:focus-visible { outline: 1px solid var(--brand-deep); outline-offset: -3px; border-radius: var(--radius); }
  .faq-question { min-width: 0; }
  .faq-icon {
    position: relative;
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    transition: transform var(--faq-duration) var(--ease);
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--brand);
    transform: translate(-50%, -50%);
  }
  .faq-icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq details[open] .faq-icon { transform: rotate(45deg); }
  .answer { overflow: hidden; color: var(--fg-2); font-size: 15px; }
  .answer-in {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    max-width: 78ch;
    padding: var(--sp-4) clamp(var(--sp-5), 4vw, var(--sp-7)) var(--sp-5) var(--sp-5);
  }
  @media (max-width: 560px) {
    .faq { gap: var(--sp-2); }
    .faq summary { min-height: 64px; padding: var(--sp-4); gap: var(--sp-4); }
    .answer-in { padding: var(--sp-3) var(--sp-6) var(--sp-4) var(--sp-4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq details, .faq-icon { transition: none; }
  }

  /* contact */
  .contact-section {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: clamp(470px, 32.5vw, 580px);
    padding-block: var(--section-space-compact);
    overflow: hidden;
    background: #100d0c;
    border-block: 1px solid var(--line);
  }
  .contact-section::before,
  .contact-section::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .contact-section::before {
    z-index: -2;
    background:
      linear-gradient(90deg, rgb(8 8 7 / 0.24) 0%, transparent 34%, transparent 68%, rgb(8 8 7 / 0.34) 100%),
      linear-gradient(180deg, rgb(8 8 7 / 0.06), rgb(8 8 7 / 0.28));
  }
  .contact-section::after {
    z-index: -1;
    box-shadow: inset 0 80px 100px -90px rgb(0 0 0 / 0.85), inset 0 -80px 100px -90px rgb(0 0 0 / 0.9);
  }
  .contact-backdrop {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .contact-shell { width: 100%; }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(440px, 0.92fr);
    grid-auto-flow: dense;
    gap: clamp(36px, 4vw, 64px);
    align-items: center;
  }
  .contact-copy { min-width: 0; }
  .contact-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 7.4ch;
    margin: 0;
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif;
    font-size: clamp(4.6rem, 5.4vw, 6rem);
    font-weight: 400;
    line-height: 0.82;
    letter-spacing: -0.018em;
    text-transform: uppercase;
    color: var(--cream);
    text-shadow: 0 4px 28px rgb(0 0 0 / 0.42);
  }
  .contact-title span,
  .contact-title strong {
    display: block;
    font: inherit;
    color: transparent;
    transform: rotate(-9deg) skewX(-2deg);
    transform-origin: left center;
    background: linear-gradient(180deg, #fffdf7 5%, #fbf4e7 54%, #e9dbc0 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .contact-title span:nth-child(2) { margin-top: -0.05em; margin-left: 0.03em; }
  .contact-title strong {
    margin-top: -0.04em;
    margin-left: 0.06em;
    background-image: linear-gradient(165deg, #ffbc32 2%, #ff871c 42%, #ff5600 78%, #dc3c00 100%);
  }
  .contact-form-placement { width: min(100%, 500px); justify-self: end; }

  @media (max-width: 980px) {
    .contact-section {
      min-height: auto;
      background-position: 36% center;
    }
    .contact-section::before {
      background:
        linear-gradient(180deg, rgb(8 8 7 / 0.14) 0%, rgb(8 8 7 / 0.2) 46%, rgb(8 8 7 / 0.7) 68%, rgb(8 8 7 / 0.82) 100%),
        linear-gradient(90deg, rgb(8 8 7 / 0.16), transparent 72%);
    }
    .contact-backdrop {
      inset: 0 0 auto;
      height: clamp(390px, 58vw, 560px);
      object-fit: cover;
      object-position: center;
    }
    .contact-grid { grid-template-columns: 1fr; gap: var(--sp-7); }
    .contact-copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: clamp(330px, 58vw, 510px);
    }
    .contact-title { font-size: clamp(4.5rem, 12vw, 7rem); }
    .contact-form-placement { width: min(100%, 720px); justify-self: center; }
  }
  @media (max-width: 560px) {
    .contact-backdrop { height: 410px; object-position: center; }
    .contact-copy { min-height: 340px; justify-content: flex-start; }
    .contact-title { max-width: 7.2ch; font-size: clamp(3.75rem, 17vw, 5.2rem); line-height: 0.8; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-backdrop, .contact-title > * { opacity: 1 !important; }
  }
</style>

<script>
  import { mountCatalogueFilter } from '../lib/catalogue-filter';
  mountCatalogueFilter('gameGrid', '#games .chip[data-filter]');

  const gameGrid = document.querySelector<HTMLElement>('#gameGrid');
  const loadGamesButton = document.querySelector<HTMLButtonElement>('[data-load-games]');
  const loadGamesRow = document.querySelector<HTMLElement>('[data-load-games-row]');

  if (gameGrid && loadGamesButton && loadGamesRow) {
    const reduceCatalogueMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cards = Array.from(gameGrid.querySelectorAll<HTMLElement>(':scope > [data-game-card]'));
    const revealed = new Set<HTMLElement>();
    let revealedRows = 3;
    let columns = 1;

    const getColumns = () => {
      const tracks = getComputedStyle(gameGrid).gridTemplateColumns.split(' ').filter(Boolean);
      return Math.max(1, tracks.length);
    };

    const orderedCards = () => Array.from(gameGrid.querySelectorAll<HTMLElement>(':scope > [data-game-card]'));

    const reveal = (items: HTMLElement[], animate = false) => {
      const fresh = items.filter((card) => !revealed.has(card));
      for (const card of fresh) {
        revealed.add(card);
        card.classList.remove('is-progressive-hidden');
      }

      if (animate && !reduceCatalogueMotion.matches) {
        fresh.forEach((card, index) => {
          card.animate(
            [
              { opacity: 0, transform: 'translateY(12px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            {
              duration: 280,
              delay: Math.min(index * 18, 126),
              easing: 'cubic-bezier(0.32, 0.72, 0, 1)',
              fill: 'backwards',
            },
          );
        });
      }
    };

    const updateButton = () => {
      const complete = revealed.size >= cards.length;
      loadGamesButton.hidden = complete;
      loadGamesRow.hidden = complete;
    };

    const render = () => {
      for (const card of cards) card.classList.toggle('is-progressive-hidden', !revealed.has(card));
      updateButton();
    };

    const preserveProgressForCurrentOrder = (animate = false) => {
      columns = getColumns();
      const target = Math.min(cards.length, columns * revealedRows);
      reveal(orderedCards().slice(0, target), animate);
      render();
    };

    columns = getColumns();
    reveal(orderedCards().slice(0, columns * revealedRows));
    gameGrid.dataset.progressiveManaged = '';
    render();

    loadGamesButton.addEventListener('click', () => {
      columns = getColumns();
      revealedRows += 3;
      const next = orderedCards().filter((card) => !revealed.has(card)).slice(0, columns * 3);
      reveal(next, true);
      render();
    });

    for (const chip of document.querySelectorAll<HTMLButtonElement>('#games .chip[data-filter]')) {
      chip.addEventListener('click', () => preserveProgressForCurrentOrder(true));
    }

    const handleCatalogueResize = () => {
      const nextColumns = getColumns();
      if (nextColumns === columns) return;
      preserveProgressForCurrentOrder();
    };
    const ResizeObserverCtor = (window as unknown as { ResizeObserver?: typeof ResizeObserver }).ResizeObserver;
    if (ResizeObserverCtor) {
      const resizeObserver = new ResizeObserverCtor(handleCatalogueResize);
      resizeObserver.observe(gameGrid);
    } else {
      window.addEventListener('resize', handleCatalogueResize, { passive: true });
    }
  }

  const faqItems = document.querySelectorAll<HTMLDetailsElement>('#faq .faq-item');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  faqItems.forEach((item) => {
    const summary = item.querySelector('summary');
    const answer = item.querySelector<HTMLElement>('.answer');
    const answerIn = item.querySelector<HTMLElement>('.answer-in');
    if (!summary || !answer || !answerIn) return;

    summary.addEventListener('click', (event) => {
      event.preventDefault();
      if (item.dataset.animating === 'true') return;

      if (reduceMotion.matches) {
        item.open = !item.open;
        return;
      }

      item.dataset.animating = 'true';
      const opening = !item.open;
      if (opening) item.open = true;

      const startHeight = opening ? 0 : answer.offsetHeight;
      const endHeight = opening ? answer.scrollHeight : 0;
      const heightAnimation = answer.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: 300, easing: 'cubic-bezier(0.32, 0.72, 0, 1)' },
      );
      const contentAnimation = answerIn.animate(
        opening
          ? { opacity: [0, 1], transform: ['translateY(-6px)', 'translateY(0)'] }
          : { opacity: [1, 0], transform: ['translateY(0)', 'translateY(-6px)'] },
        { duration: 300, easing: 'cubic-bezier(0.32, 0.72, 0, 1)' },
      );

      Promise.all([heightAnimation.finished, contentAnimation.finished]).then(() => {
        if (!opening) item.open = false;
        delete item.dataset.animating;
      });
    });
  });

  const contactSection = document.querySelector<HTMLElement>('.contact-section');
  const contactBackdrop = document.querySelector<HTMLElement>('.contact-backdrop');
  const contactTitleLines = document.querySelectorAll<HTMLElement>('.contact-title > *');

  if (contactSection && contactBackdrop && contactTitleLines.length && !reduceMotion.matches) {
    Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([{ gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);
      gsap.fromTo(
        contactBackdrop,
        { scale: 1.035, opacity: 0.78 },
        {
          scale: 1,
          opacity: 1,
          ease: 'none',
          scrollTrigger: { trigger: contactSection, start: 'top bottom', end: 'bottom top', scrub: 0.7 },
        },
      );
      gsap.fromTo(
        contactTitleLines,
        { y: 22, opacity: 0.2 },
        {
          y: 0,
          opacity: 1,
          stagger: 0.12,
          ease: 'none',
          scrollTrigger: { trigger: contactSection, start: 'top 88%', end: 'top 48%', scrub: 0.55 },
        },
      );
    });
  }
</script>
