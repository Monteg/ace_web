---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import { localeFromPath, t } from '../lib/i18n';

interface Props {
  name: string;
  src: string;
  poster: ImageMetadata;
  posterAlt?: string;
}

const { name, src, poster, posterAlt = '' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
const copyDefault = t('game.media.copy_link', locale);
---

<!--
  Click to play. The old site booted an 11 to 61 MB game client on page load,
  which is why a game page opened as a black rectangle for six seconds or more.
  Nothing is fetched here until the visitor asks for it.
-->
<div class="demo" data-src={src} data-copied={t('global.action.copied', locale)} data-copy-failed={t('global.action.copy_failed', locale)} data-copy-default={copyDefault}>
  <div class="demo-poster">
    <Image src={poster} alt={posterAlt} widths={[900, 1400, 1920]} sizes="100vw" loading="lazy" />
  </div>

  <button class="demo-play" type="button" data-play>
    <span class="disc" aria-hidden="true"><Icon name="ph:play-fill" /></span>
    <span class="lab">{t('game.media.play_title', locale, { name })}</span>
    <span class="sub">{t('game.media.free_play', locale)}</span>
  </button>

  <div class="demo-loading" data-loading hidden>
    <p class="lab">{t('game.media.loading', locale, { name })}</p>
    <div class="skel" role="progressbar" aria-label={t('game.media.loading', locale, { name })}><i></i></div>
  </div>
</div>

<p class="demo-note">
  <span class="age">18+</span>
  <span>{t('game.media.evaluation', locale)}</span>
  <span>{t('game.media.operator_only', locale)}</span>
  <button class="copy" type="button" data-copy={src}>
    <Icon name="ph:link-simple" />
    <span data-copy-label>{copyDefault}</span>
  </button>
</p>

<style>
  .demo {
    position: relative; aspect-ratio: 16 / 9; max-height: 80svh;
    border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; background: #000;
  }
  .demo-poster { position: absolute; inset: 0; }
  .demo-poster :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.42; }
  .demo-poster::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(72% 72% at 50% 50%, rgb(17 17 17 / 0.62), rgb(17 17 17 / 0.94));
  }

  .demo-play {
    position: absolute; inset: 0; z-index: 2;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--sp-4); padding: var(--sp-5);
    background: transparent; border: 0; cursor: pointer; color: var(--fg); font: inherit;
  }
  .disc {
    width: 74px; height: 74px; border-radius: var(--radius-pill); background: var(--brand);
    display: grid; place-items: center; color: var(--on-brand-button);
    transition: transform 0.2s var(--ease);
  }
  .disc svg { width: 30px; height: 30px; stroke: currentColor; stroke-width: var(--button-icon-stroke); stroke-linejoin: round; }
  .demo-play:hover .disc { transform: scale(1.07); }
  @media (prefers-reduced-motion: reduce) { .demo-play:hover .disc { transform: none; } }

  .lab {
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-size: 1.35rem;
    text-shadow: 0 2px 12px rgb(17 17 17 / 0.9);
  }
  .demo-play .lab { color: var(--on-brand-button); font-weight: var(--button-label-weight); letter-spacing: var(--button-label-spacing); }
  .sub {
    font-size: 13px; color: var(--fg-2); max-width: 38ch; text-align: center; line-height: 1.5;
    text-shadow: 0 1px 10px rgb(17 17 17 / 0.95);
  }

  .demo-loading {
    position: absolute; inset: 0; z-index: 3; background: #000;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--sp-4); padding: var(--sp-5);
  }
  .demo-loading[hidden] { display: none; }
  .skel { width: min(360px, 80%); height: 8px; border-radius: var(--radius-pill); background: var(--ink-3); overflow: hidden; position: relative; }
  .skel i { position: absolute; inset: 0; width: 38%; background: linear-gradient(90deg, transparent, var(--line-2), transparent); animation: sh 1.15s linear infinite; }
  @keyframes sh { from { transform: translateX(-100%); } to { transform: translateX(320%); } }
  @media (prefers-reduced-motion: reduce) { .skel i { animation: none; width: 100%; opacity: 0.4; } }

  .demo :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 4; }

  .demo-note {
    display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-5); align-items: center;
    margin-top: var(--sp-3); font-size: 12.5px; color: var(--fg-3);
  }
  .age {
    font-family: 'JetBrains Mono Variable', monospace; font-size: 11px;
    border: 1px solid var(--line-2); border-radius: var(--radius-pill);
    padding: 4px 10px; color: var(--fg-2);
  }
  /* an evaluator shares demos with their team all day; one click, no URL bar */
  .copy {
    margin-left: auto; display: inline-flex; align-items: center; gap: 6px;
    font: inherit; font-size: 12.5px; color: var(--fg-2); cursor: pointer;
    background: transparent; border: 1px solid var(--line-2); border-radius: var(--radius-pill);
    padding: 7px 12px; min-height: 36px; transition: color var(--dur-1), border-color var(--dur-1);
  }
  .copy:hover { color: var(--fg); border-color: var(--fg-3); }
  .copy svg { width: 14px; height: 14px; }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.copy[data-copy]')) {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        label.textContent = btn.closest<HTMLElement>('.demo-note')?.previousElementSibling?.getAttribute('data-copied') ?? 'Copied';
      } catch {
        label.textContent = btn.closest<HTMLElement>('.demo-note')?.previousElementSibling?.getAttribute('data-copy-failed') ?? 'Copy failed';
      }
      const demo = btn.closest<HTMLElement>('.demo-note')?.previousElementSibling;
      setTimeout(() => (label.textContent = demo?.getAttribute('data-copy-default') ?? 'Copy demo link'), 1800);
    });
  }

  for (const demo of document.querySelectorAll<HTMLElement>('.demo[data-src]')) {
    const play = demo.querySelector<HTMLButtonElement>('[data-play]');
    const loading = demo.querySelector<HTMLElement>('[data-loading]');
    if (!play || !loading) continue;

    play.addEventListener(
      'click',
      () => {
        play.hidden = true;
        loading.hidden = false;

        const frame = document.createElement('iframe');
        frame.src = demo.dataset.src!;
        frame.title = play.querySelector('.lab')?.textContent?.trim() ?? 'Game demo';
        frame.allow = 'fullscreen; autoplay; gamepad';
        frame.allowFullscreen = true;
        // The game runs on our own domain, but it is still a separate origin:
        // give it only what it needs.
        frame.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups');
        frame.addEventListener('load', () => {
          loading.hidden = true;
        });
        demo.appendChild(frame);
      },
      { once: true },
    );
  }
</script>
