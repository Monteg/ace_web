---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { EventData } from '../../data/events';
import aceCityFeatured from '../../assets/event/games/ace-city-featured.png';
import GameTile from '../showcase/GameTile.astro';
import EventGameCard from './EventGameCard.astro';
import { localeFromPath, localizePath, t } from '../../lib/i18n';
interface Props { event: EventData; games: CollectionEntry<'games'>[] }
const { event, games } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
---

<section aria-labelledby="event-games-title">
  <div class="wrap">
    <div class="sec-top event-section-title-wrap rv"><h2 class="d1 event-section-title" id="event-games-title">{event.gamesTitle}</h2></div>
    <div class="event-games-grid">
      {event.featuredGames.map((item, index) => {
        const game = games.find(entry => entry.id === item.id);
        if (!game) return null;
        return index === 0
          ? <EventGameCard game={game} name={item.name} description={item.description} lead image={aceCityFeatured} />
          : <GameTile game={game} showStats={false} description={item.description} />;
      })}
    </div>
    <a class="btn btn-ghost games-cta rv" href={localizePath('/games', locale)} data-event-track="explore_all_games">{t('event.games.explore_all', locale)}<span class="disc" aria-hidden="true"><Icon name="ph:arrow-right" /></span></a>
  </div>
</section>

<style>
  .sec-top { max-width: none; }
  .event-games-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-5); }
  .games-cta { margin-top: var(--sp-6); }
  @media (max-width: 992px) { .event-games-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .event-games-grid { grid-template-columns: 1fr; } }
</style>
