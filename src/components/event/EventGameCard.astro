---
import ContentImage from '../ContentImage.astro';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

interface Props { game: CollectionEntry<'games'>; name: string; description: string; lead?: boolean }
const { game, name, description, lead = false } = Astro.props;
const href = `/portfolio/${game.id}`;
---

<article class:list={['event-game', 'rv', { 'event-game-lead': lead }]}>
  <a class="game-visual" href={href} aria-label={`Explore ${name}`}>
    <ContentImage src={lead ? game.data.hero : game.data.card} alt={`${name} game artwork`} widths={lead ? [480, 800, 1200] : [360, 540, 720]} sizes={lead ? '(max-width: 768px) 92vw, 760px' : '(max-width: 600px) 92vw, (max-width: 992px) 46vw, 400px'} loading="lazy" />
  </a>
  <div class="game-copy">
    <h3><a href={href}>{name}<Icon name="ph:arrow-up-right" aria-hidden="true" /></a></h3>
    <p>{description}</p>
  </div>
</article>

<style>
  .event-game { min-width: 0; display: flex; flex-direction: column; border-radius: var(--radius-l); background: var(--ink-2); box-shadow: var(--shadow-1); overflow: hidden; }
  .game-visual { display: block; overflow: hidden; aspect-ratio: 4 / 3; background: var(--ink-3); }
  .game-visual :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-2) var(--ease); }
  .game-visual:hover :global(img) { transform: scale(1.035); }
  .game-visual:focus-visible { outline-offset: -4px; }
  .game-copy { padding: var(--sp-5); }
  .game-copy h3 { margin: 0 0 var(--sp-3); font-size: 1.5rem; font-weight: 650; line-height: 1.3; letter-spacing: -0.02em; }
  .game-copy h3 a { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3); text-decoration: none; }
  .game-copy h3 a:hover { color: var(--peach); }
  .game-copy h3 svg { width: 20px; height: 20px; flex: none; color: var(--fg-2); }
  .game-copy p { font-size: 1rem; line-height: 1.65; color: var(--fg-2); }
  .event-game-lead { display: grid; grid-template-columns: 1.7fr 1fr; grid-column: 1 / -1; }
  .event-game-lead .game-visual { aspect-ratio: 16 / 9; }
  .event-game-lead .game-copy { padding: clamp(24px, 3vw, 48px); align-self: center; }
  .event-game-lead h3 { font-family: Tanker, 'Tanker Fallback', sans-serif; font-weight: 400; font-size: var(--step-3); }
  @media (max-width: 768px) { .event-game-lead { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .game-visual :global(img) { transition: none; } .game-visual:hover :global(img) { transform: none; } }
</style>
