---
import type { EventData } from '../../data/events';
interface Props { event: EventData }
const { event } = Astro.props;
---

<section class="event-why" aria-labelledby="why-event-title">
  <div class="wrap">
    <div class="sec-top rv"><h2 class="d1" id="why-event-title">{event.whyTitle}</h2></div>
    <ol class="why-grid">
      {event.reasons.map((reason, index) => (
        <li class="reason rv">
          <span class="reason-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{reason.title}</h3>
          <p>{reason.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .event-why { padding-top: var(--sp-7); }
  .why-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-6); list-style: none; }
  .reason { border-top: 1px solid var(--line-2); padding-top: var(--sp-5); }
  .reason-number { display: block; font-family: Tanker, 'Tanker Fallback', sans-serif; font-size: 3.5rem; line-height: 1; color: var(--brand); margin-bottom: var(--sp-5); }
  .reason h3 { font-size: 1.25rem; font-weight: 650; line-height: 1.35; margin: 0 0 var(--sp-4); }
  .reason p { color: var(--fg-2); font-size: 1rem; line-height: 1.7; }
  @media (max-width: 768px) {
    .why-grid { grid-template-columns: 1fr; }
    .reason-number { font-size: 2.75rem; margin-bottom: var(--sp-4); }
  }
</style>
