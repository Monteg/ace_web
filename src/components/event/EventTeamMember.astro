---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { EventData, EventTeamMember } from '../../data/events';
import { memberBookingUrl } from '../../lib/event';
import { localeFromPath, t } from '../../lib/i18n';
interface Props { member: EventTeamMember; event: EventData }
const { member, event } = Astro.props;
const usesLocalBooking = !member.bookingUrl && !event.bookingUrl;
const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
---

<article class="team-member rv">
  <div class="member-photo">
    {member.photo ? (
      <Image src={member.photo} alt={member.name} widths={[360, 540, 720]} sizes="(max-width: 768px) 92vw, 400px" loading="lazy" />
    ) : (
      <div class="photo-pending" role="img" aria-label={t('event.team.portrait_pending_aria', locale, { name: member.name })}>
        <span class="initial" aria-hidden="true">{member.name[0]}</span>
        <span class="need">{t('event.team.portrait_pending', locale)}</span>
      </div>
    )}
  </div>
  <div class="member-copy">
    <div class="member-name-row">
      <h3>{member.name}</h3>
      <a class="linkedin" href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={t('event.team.linkedin_aria', locale, { name: member.name })} data-event-track={`linkedin_${member.id}`}><Icon name="ph:linkedin-logo" /></a>
    </div>
    {member.position && <p class="position">{member.position}</p>}
    <p class="expertise">{member.expertise}</p>
    <a class="btn btn-ghost" href={memberBookingUrl(event, member)} data-event-member={usesLocalBooking ? member.id : undefined} data-event-track={`book_meeting_${member.id}`}>{t('event.team.meet_cta', locale, { name: member.name })}</a>
  </div>
</article>

<style>
  .team-member { display: flex; flex-direction: column; min-width: 0; }
  .member-photo { aspect-ratio: 4 / 4.5; border-radius: var(--radius-l); background: var(--ink-2); overflow: hidden; }
  .member-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .photo-pending { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--sp-5); border: 1px dashed var(--line-2); border-radius: inherit; }
  .initial { font-family: Tanker, 'Tanker Fallback', sans-serif; font-size: clamp(6rem, 12vw, 10rem); line-height: 1; color: var(--line-2); }
  .photo-pending .need { font-size: 0.875rem; }
  .member-copy { display: flex; flex-direction: column; align-items: flex-start; flex: 1; padding-top: var(--sp-4); gap: var(--sp-3); }
  .member-name-row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); width: 100%; }
  .member-name-row h3 { margin: 0; font-size: 1.5rem; font-weight: 650; line-height: 1.3; }
  .linkedin { display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-pill); border: 1px solid var(--line-2); color: var(--fg-2); transition: color var(--dur-1), border-color var(--dur-1); }
  .linkedin svg { width: 21px; height: 21px; }
  .linkedin:hover { border-color: var(--peach); color: var(--peach); }
  .expertise { font-size: 1rem; color: var(--fg-2); line-height: 1.6; padding-bottom: var(--sp-3); }
  .position { font-size: 0.875rem; color: var(--peach); }
  .member-copy .btn { margin-top: auto; }
  @media (prefers-reduced-motion: reduce) { .linkedin { transition: none; } }
</style>
