---
/**
 * Catalogue tile. The art is the object; name, RTP and volatility sit in a
 * bar under it so they are readable on touch, and the hover state adds the
 * Play affordance and a slow push-in on the art.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { rtp, TYPE_LABEL, volatility } from '../../lib/format';

interface Props {
  game: CollectionEntry<'games'>;
  eager?: boolean;
  /** Renders larger art and copy; used for the first tile of the grid. */
  featured?: boolean;
}

const { game, eager = false, featured = false } = Astro.props;
const d = game.data;
const soon = d.status === 'coming_soon';
const href = `/portfolio/${game.id}`;
const bands = ['low', 'medium', 'high', 'very_high'] as const;
---

<article class:list={['gt', { 'gt-featured': featured, 'gt-soon': soon }]} data-type={d.type} data-status={d.status}>
  <a class="gt-link" href={href}>
    <span class="sr-only">{d.name}, {TYPE_LABEL[d.type]}{soon ? ', coming soon' : ''}</span>
  </a>

  <div class="gt-art">
    <Image
      src={d.card}
      alt=""
      widths={featured ? [640, 900, 1200] : [320, 460, 640]}
      sizes={featured
        ? '(max-width: 768px) 92vw, (max-width: 1100px) 60vw, 640px'
        : '(max-width: 480px) 92vw, (max-width: 768px) 46vw, (max-width: 1100px) 31vw, 300px'}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <span class:list={['gt-type', `gt-type-${d.type}`]}>{soon ? 'Coming soon' : TYPE_LABEL[d.type]}</span>
    <span class="gt-play" aria-hidden="true">
      <Icon name={soon ? 'ph:eye' : 'ph:play-fill'} />
      <b>{soon ? 'Preview' : 'Play'}</b>
    </span>
  </div>

  <div class="gt-bar">
    <h3 class="sr-only">{d.name}</h3>
    <dl class="gt-meta">
      <div class="gt-stat">
        <dt>RTP</dt>
        <dd class:list={['gt-rtp', 'tnum', { 'gt-rtp-configurable': d.specs.rtp === 'configurable' }]}>{rtp(d.specs.rtp)}</dd>
      </div>
      <div class="gt-stat">
        <dt class="gt-volatility-heading">
          Volatility
          <span class="vmeter" aria-hidden="true">
            {bands.map((b) => <i class:list={{ on: d.specs.volatility.includes(b) }}></i>)}
          </span>
        </dt>
        <dd class="gt-volatility">{volatility(d.specs.volatility)}</dd>
      </div>
    </dl>
  </div>
</article>

<style>
  .gt {
    position: relative; display: flex; flex-direction: column;
    min-width: 0; container-type: inline-size;
    border-radius: var(--radius-l); overflow: hidden;
    background: var(--ink-2); box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease);
  }
  .gt:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
  .gt:has(.gt-link:focus-visible) { outline: 3px solid var(--brand); outline-offset: 3px; }
  .gt-link { position: absolute; inset: 0; z-index: 3; }
  .gt-link:focus-visible { outline: none; }

  .gt-art { position: relative; aspect-ratio: 1200 / 1057; background: var(--ink-3); overflow: hidden; }
  .gt-art :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.4s var(--ease);
  }
  .gt:hover .gt-art :global(img) { transform: scale(1.06); }
  .gt-soon .gt-art :global(img) { filter: saturate(0.75) brightness(0.8); }

  .gt-type {
    position: absolute; left: 12px; top: 12px; z-index: 1;
    font-family: 'JetBrains Mono Variable', monospace; font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.04em; text-transform: uppercase;
    padding: 5px 9px; border-radius: var(--radius-pill); color: var(--tint-ink);
  }
  .gt-type-slot { background: var(--tint-ice); }
  .gt-type-instant { background: var(--tint-mint); }
  .gt-type-table { background: var(--tint-lemon); }
  .gt-soon .gt-type { background: var(--peach); }

  .gt-play {
    position: absolute; right: 12px; bottom: 12px; z-index: 1;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 14px 9px 10px; border-radius: var(--radius-pill);
    background: var(--brand); color: var(--on-brand-button);
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-size: 0.95rem;
    font-weight: var(--button-label-weight); letter-spacing: var(--button-label-spacing);
    opacity: 0; transform: translateY(8px);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-2) var(--ease);
  }
  .gt-play svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: var(--button-icon-stroke); stroke-linejoin: round; }
  .gt-play b { font-weight: 400; }
  .gt:hover .gt-play, .gt:has(.gt-link:focus-visible) .gt-play { opacity: 1; transform: none; }
  @media (hover: none) { .gt-play { opacity: 1; transform: none; } }

  .gt-bar {
    padding: var(--sp-5); display: flex; flex: 1; align-items: flex-end;
    border-top: 1px solid var(--line);
  }
  .gt-meta {
    display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--sp-4); width: 100%; margin: 0;
  }
  .gt-stat { min-width: 0; }
  .gt-meta dt {
    color: var(--fg-2); font-size: 0.8125rem; font-weight: 500;
    line-height: 1.4; margin-bottom: var(--sp-2);
  }
  .gt-meta dd { margin: 0; color: var(--fg); }
  .gt-rtp {
    font-family: 'JetBrains Mono Variable', monospace; font-size: 1.375rem;
    font-weight: 600; line-height: 1.25; letter-spacing: -0.04em;
  }
  .gt-rtp.gt-rtp-configurable {
    font-family: inherit; font-size: 0.875rem; line-height: 1.5;
    letter-spacing: normal; overflow-wrap: anywhere;
  }
  .gt-volatility {
    display: flex; align-items: center; min-height: 1.71875rem;
    font-size: 0.875rem; line-height: 1.4; font-weight: 500;
  }
  .gt-volatility-heading { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-2); }
  .gt-volatility-heading .vmeter { flex-shrink: 0; }

  @container (max-width: 260px) {
    .gt-bar { padding: var(--sp-4); }
    .gt-meta { grid-template-columns: minmax(0, 1fr); gap: var(--sp-3); }
    .gt-stat { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-2); }
    .gt-meta dt { margin-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gt, .gt-art :global(img), .gt-play { transition: none; }
    .gt:hover { transform: none; }
    .gt:hover .gt-art :global(img) { transform: none; }
  }
</style>
