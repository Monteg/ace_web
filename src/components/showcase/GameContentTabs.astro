---
import GameSections from './GameSections.astro';
import type { GameDetailViewModel } from '../../lib/content-source';
import { getTranslations } from '../../i18n/get-translations';

interface Props {
  id: string;
  gameName: string;
  tabs: GameDetailViewModel['tabs'];
  locale?: string;
}

const { id, gameName, tabs, locale = 'en' } = Astro.props;
const t = await getTranslations(locale);
const labelKeys = {
  gameplay: 'game.tabs.gameplay',
  main_feature: 'game.tabs.main_feature',
  bonus: 'game.tabs.bonus',
  multiplier: 'game.tabs.multiplier',
} as const;
---

{tabs.length > 0 && (
  <section class="game-tabs-section">
    <div class="wrap">
      <div class="game-tabs" data-game-tabs>
        <div class="game-tabs__list" role="tablist" aria-label={t('game.tabs.aria', { name: gameName })} data-content-tablist hidden>
          {tabs.map((tab, index) => (
            <button
              id={`${id}-tab-${tab.slot}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`${id}-panel-${tab.slot}`}
              tabindex={index === 0 ? 0 : -1}
              data-content-tab
            >
              {t(labelKeys[tab.slot])}
            </button>
          ))}
        </div>
        <div class="game-tabs__panels">
          {tabs.map((tab) => (
            <div
              id={`${id}-panel-${tab.slot}`}
              class="game-tabs__panel"
              role="tabpanel"
              aria-labelledby={`${id}-tab-${tab.slot}`}
              data-content-panel
            >
              <h2 class="game-tabs__fallback-heading d3">{t(labelKeys[tab.slot])}</h2>
              <GameSections sections={tab.sections} variant="tab" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .game-tabs-section { padding-block: 0 var(--section-space-compact); }
  .game-tabs { max-width: 980px; }
  .game-tabs__list {
    scrollbar-width: thin;
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid var(--line);
  }
  .game-tabs__list[hidden] { display: none; }
  .game-tabs__list button {
    position: relative;
    min-width: max-content;
    min-height: 48px;
    padding: 12px 22px;
    color: var(--fg-2);
    background: transparent;
    border: 0;
    cursor: pointer;
    font: 600 12px/1.2 'Inter Variable', Inter, sans-serif;
    letter-spacing: 0.02em;
  }
  .game-tabs__list button::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    background: var(--brand);
    opacity: 0;
    transform: scaleX(0.5);
    transition: opacity var(--dur-1), transform var(--dur-1) var(--ease);
  }
  .game-tabs__list button:hover { color: var(--fg); }
  .game-tabs__list button[aria-selected='true'] { color: var(--fg); }
  .game-tabs__list button[aria-selected='true']::after { opacity: 1; transform: scaleX(1); }
  .game-tabs__panel { padding-top: var(--sp-5); }
  .game-tabs__panel + .game-tabs__panel { margin-top: var(--sp-6); padding-top: var(--sp-6); border-top: 1px solid var(--line); }
  .game-tabs__fallback-heading { margin-bottom: var(--sp-4); }
  .game-tabs.is-tabs-ready .game-tabs__fallback-heading { display: none; }
  .game-tabs.is-tabs-ready .game-tabs__panel + .game-tabs__panel { margin-top: 0; padding-top: var(--sp-5); border-top: 0; }
  .game-tabs.is-tabs-ready .game-tabs__panel[hidden] { display: none; }

  @media (max-width: 600px) {
    .game-tabs__list { margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
    .game-tabs__list button { min-height: 52px; padding-inline: var(--sp-4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .game-tabs__list button::after { transition: none; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-game-tabs]')) {
    const list = root.querySelector<HTMLElement>('[data-content-tablist]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-content-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-content-panel]'));
    if (!list || !tabs.length || tabs.length !== panels.length) continue;

    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, candidate) => {
        const active = candidate === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[candidate].hidden = !active;
      });
      if (focus) tabs[index].focus();
    };

    root.classList.add('is-tabs-ready');
    list.hidden = false;
    activate(0);
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(next, true);
      });
    });
  }
</script>
