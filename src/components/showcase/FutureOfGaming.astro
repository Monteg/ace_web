---
import { Image } from 'astro:assets';
import engineeringArt from '../../assets/site/future-engineering.png';
import strategyArt from '../../assets/site/future-strategy.png';
import integrationArt from '../../assets/site/future-integration.png';
import optimizationArt from '../../assets/site/future-optimization.png';
import { process, sectionCopy } from '../../data/site';

const artwork = {
  engineering: engineeringArt,
  strategy: strategyArt,
  integration: integrationArt,
  optimization: optimizationArt,
};
---

<section class="future" id="why-ace-games" aria-labelledby="future-title" data-future-section>
  <div class="wrap">
    <div class="sec-top home-section-heading rv">
      <h2 class="d1" id="future-title">{sectionCopy.futureTitle}</h2>
    </div>

    <div class="future-grid" data-future-grid>
      {process.map((item, index) => (
        <article class={`future-card future-card--${index + 1}`} data-future-card>
          <span class="future-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>

          <div class="future-art" aria-hidden="true">
            <Image
              src={artwork[item.image as keyof typeof artwork]}
              alt=""
              widths={[360, 540, 760, 1024]}
              sizes="(max-width: 760px) 92vw, (max-width: 980px) 48vw, 48vw"
              loading="lazy"
              quality={86}
            />
          </div>

          <div class="future-copy">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .future {
    position: relative;
    overflow: clip;
    border-bottom: 1px solid var(--line);
  }
  .future::before {
    content: '';
    position: absolute;
    inset: 12% 8% auto;
    height: 62%;
    pointer-events: none;
    background: radial-gradient(circle at 50% 50%, rgb(255 86 0 / 0.045), transparent 68%);
    filter: blur(28px);
  }
  .future-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(20, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(14px, 1.45vw, 22px);
    isolation: isolate;
  }
  .future-card {
    position: relative;
    isolation: isolate;
    min-width: 0;
    min-height: clamp(286px, 21vw, 326px);
    overflow: visible;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.018), transparent 38%),
      #101111;
    border: 1px solid #1f2021;
    border-radius: clamp(16px, 1.5vw, 20px);
    box-shadow: 0 24px 55px -42px rgb(0 0 0 / 0.95);
    transform-origin: center;
  }
  .future-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(16 17 17 / 0.96) 0%, rgb(16 17 17 / 0.84) 25%, transparent 64%);
  }
  .future-card--1,
  .future-card--2 { grid-row: 1; }
  .future-card--3,
  .future-card--4 { grid-row: 2; }
  .future-card--1 { z-index: 4; grid-column: span 7; }
  .future-card--2 { z-index: 1; grid-column: span 13; }
  .future-card--3 { z-index: 3; grid-column: span 8; }
  .future-card--4 { z-index: 2; grid-column: span 12; }

  .future-number {
    position: absolute;
    top: clamp(18px, 1.9vw, 28px);
    left: clamp(16px, 1.7vw, 24px);
    z-index: 4;
    font-family: Tanker, 'Tanker Fallback', 'Arial Narrow', Impact, sans-serif;
    font-size: clamp(2.65rem, 3.2vw, 3.85rem);
    font-weight: 400;
    line-height: 0.85;
    color: rgb(244 241 230 / 0.46);
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.65);
  }
  .future-art {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    transform: translateZ(0);
    filter: drop-shadow(0 24px 28px rgb(0 0 0 / 0.34));
  }
  .future-art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 700ms var(--ease-out);
  }
  .future-card:hover .future-art :global(img) { transform: translateY(-3px) scale(1.018); }

  .future-card--1 .future-art {
    top: -15%;
    right: -3%;
    width: 76%;
    height: 99%;
    transform: rotate(-1.2deg) translateZ(0);
  }
  .future-card--2 .future-art {
    top: -22%;
    right: -2%;
    width: 72%;
    height: 130%;
    transform: rotate(-1.35deg) translateZ(0);
  }
  .future-card--3 .future-art {
    top: -23%;
    right: -13%;
    width: 82%;
    height: 118%;
    transform: rotate(1.45deg) translateZ(0);
  }
  .future-card--4 .future-art {
    top: -11%;
    right: -8%;
    width: 78%;
    height: 112%;
    transform: rotate(-1.15deg) translateZ(0);
  }

  .future-copy {
    position: absolute;
    bottom: clamp(24px, 3vw, 42px);
    left: clamp(16px, 1.7vw, 24px);
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 11px;
    width: min(48%, 350px);
    text-shadow: 0 3px 18px rgb(0 0 0 / 0.88);
  }
  .future-card--1 .future-copy { width: min(67%, 270px); }
  .future-card--3 .future-copy { width: min(47%, 270px); }
  .future-card--4 .future-copy { width: min(41%, 285px); }
  .future-copy h3 {
    max-width: 18ch;
    margin: 0;
    font-family: Tanker, 'Tanker Fallback', 'Arial Narrow', Impact, sans-serif;
    font-size: clamp(1.44rem, 1.75vw, 1.82rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: 0.004em;
    text-transform: none;
    text-wrap: balance;
    color: var(--fg);
  }
  .future-copy p {
    max-width: 35ch;
    color: rgb(244 241 230 / 0.64);
    font-size: clamp(0.94rem, 1vw, 1.04rem);
    line-height: 1.42;
  }

  @media (max-width: 980px) {
    .future-grid { grid-template-columns: 1fr; }
    .future-card--1,
    .future-card--2,
    .future-card--3,
    .future-card--4 {
      grid-column: span 1;
      grid-row: auto;
      min-height: clamp(300px, 43vw, 360px);
    }
    .future-card--1 .future-art { top: -18%; right: -2%; width: 59%; height: 111%; }
    .future-card--2 .future-art { top: -20%; right: -3%; width: 68%; height: 124%; }
    .future-card--3 .future-art { top: -13%; right: -4%; width: 59%; height: 112%; }
    .future-card--4 .future-art { top: -4%; right: -5%; width: 71%; height: 103%; }
    .future-copy { width: min(43%, 310px); }
    .future-card--1 .future-copy { width: min(48%, 310px); }
    .future-card--3 .future-copy { width: min(43%, 290px); }
    .future-card--4 .future-copy { width: min(39%, 280px); }
    .future-copy h3 { font-size: clamp(1.42rem, 2.7vw, 1.75rem); }
    .future-copy p { font-size: clamp(0.93rem, 1.75vw, 1.02rem); }
  }

  @media (max-width: 760px) {
    .future-grid { grid-template-columns: 1fr; gap: var(--sp-5); }
    .future-card--1,
    .future-card--2,
    .future-card--3,
    .future-card--4 {
      min-height: clamp(330px, 91vw, 410px);
      overflow: hidden;
    }
    .future-card::after {
      background: linear-gradient(180deg, transparent 28%, rgb(16 17 17 / 0.52) 57%, rgb(16 17 17 / 0.98) 79%);
    }
    .future-number { top: var(--sp-5); left: var(--sp-5); }
    .future-card--1 .future-art { top: -17%; right: -5%; width: 89%; height: 91%; }
    .future-card--2 .future-art { top: -8%; right: -12%; width: 106%; height: 82%; }
    .future-card--3 .future-art { top: -11%; right: -6%; width: 94%; height: 87%; }
    .future-card--4 .future-art { top: 2%; right: -14%; width: 112%; height: 68%; }
    .future-copy,
    .future-card--1 .future-copy,
    .future-card--3 .future-copy,
    .future-card--4 .future-copy {
      right: var(--sp-5);
      bottom: var(--sp-5);
      left: var(--sp-5);
      width: auto;
    }
    .future-copy h3 { max-width: 22ch; font-size: clamp(1.42rem, 6.3vw, 1.85rem); }
    .future-copy p { max-width: 40ch; font-size: clamp(0.88rem, 3.6vw, 1rem); line-height: 1.42; }
  }

  @media (hover: none), (pointer: coarse) {
    .future-card:hover .future-art :global(img) { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .future-art :global(img) { transition: none; }
    .future-card:hover .future-art :global(img) { transform: none; }
  }
</style>

<script>
  const futureSection = document.querySelector<HTMLElement>('[data-future-section]');
  const futureCards = Array.from(document.querySelectorAll<HTMLElement>('[data-future-card]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (futureSection && futureCards.length && !reduceMotion.matches) {
    Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([{ gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);
      const mobile = window.matchMedia('(max-width: 760px)').matches;

      if (mobile) {
        futureCards.forEach((card, index) => {
          gsap.fromTo(
            card,
            { x: index % 2 === 0 ? -34 : 34, y: 30, scale: 0.975, opacity: 0.5 },
            {
              x: 0,
              y: 0,
              scale: 1,
              opacity: 1,
              ease: 'none',
              scrollTrigger: { trigger: card, start: 'top 92%', end: 'top 64%', scrub: 0.45 },
            },
          );
        });
      } else {
        const centerOffsets = [
          { x: -96, y: -34 },
          { x: 96, y: -34 },
          { x: -96, y: 34 },
          { x: 96, y: 34 },
        ];
        gsap.fromTo(
          futureCards,
          {
            x: (index) => centerOffsets[index]?.x ?? 0,
            y: (index) => centerOffsets[index]?.y ?? 0,
            scale: 0.96,
            opacity: 0.48,
          },
          {
            x: 0,
            y: 0,
            scale: 1,
            opacity: 1,
            stagger: 0.035,
            ease: 'none',
            scrollTrigger: {
              trigger: futureSection,
              start: 'top 88%',
              end: 'top 43%',
              scrub: 0.65,
            },
          },
        );
      }
    });
  }
</script>
