---
/**
 * The catalogue as a maths map, drawn so a buyer reads it in one glance.
 *
 * Four horizontal lanes, one per volatility band, top to bottom from the
 * wildest to the gentlest. Every game is its own key art, placed along the
 * lane by published RTP: further right, more returned to the player. A title
 * whose volatility is adjustable spans lanes with a thin bracket. Filtering
 * never hides anything, it dims what does not match, so the buyer finds what
 * they asked for without losing sight of the rest.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { maxWin, rtp as fmtRtp, volatility as fmtVol } from '../../lib/format';
import { localeFromPath, localizePath, t } from '../../lib/i18n';
import { getLocalizedGame } from '../../lib/localized-games';

interface Props {
  games: CollectionEntry<'games'>[];
}
const { games } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);

const BANDS = ['low', 'medium', 'high', 'very_high'] as const;
const LANE_LABEL: Record<(typeof BANDS)[number], string> = {
  low: t('global.label.low', locale),
  medium: t('global.label.medium', locale),
  high: t('global.label.high', locale),
  very_high: t('global.label.very_high', locale),
};
// lane 0 is the top row (very high), lane 3 the bottom (low)
const laneOf = (b: (typeof BANDS)[number]) => 3 - BANDS.indexOf(b);

const numeric = games.filter(
  (game) =>
    game.data.status === 'live' &&
    typeof game.data.specs.rtp === 'number' &&
    game.data.specs.volatility.length > 0,
);

const rtps = numeric.map((g) => g.data.specs.rtp as number);
const lo = Math.floor(Math.min(...rtps) * 100) / 100 - 0.003;
const hi = Math.ceil(Math.max(...rtps) * 100) / 100 + 0.003;
const xOf = (r: number) => ((r - lo) / (hi - lo)) * 100;

const ticks: number[] = [];
for (let t = Math.ceil(lo * 100); t <= Math.floor(hi * 100); t++) ticks.push(t / 100);

type Placed = {
  game: CollectionEntry<'games'>;
  x: number;
  lane: number;
  row: 0 | 1;
  from: number;
  to: number;
  spans: boolean;
};

// place every game; two titles closer than 4.5% of the track in the same lane
// take the second row so nothing overlaps
const placed: Placed[] = [];
const perLane: Placed[][] = [[], [], [], []];
for (const game of numeric.sort((a, b) => (a.data.specs.rtp as number) - (b.data.specs.rtp as number))) {
  const bands = game.data.specs.volatility;
  const lanes = bands.map(laneOf);
  const from = Math.min(...lanes);
  const to = Math.max(...lanes);
  // two neighbouring bands sit between the lanes; three or more get a bracket
  const lane = (from + to) / 2;
  const x = xOf(game.data.specs.rtp as number);
  const bucket = perLane[Math.round(lane)];
  const near = bucket.filter((p) => Math.abs(p.x - x) < 4.5);
  const row: 0 | 1 = near.some((p) => p.row === 0) ? (near.some((p) => p.row === 1) ? 0 : 1) : 0;
  const item: Placed = { game, x, lane, row, from, to, spans: to - from >= 2 };
  bucket.push(item);
  placed.push(item);
}

const types = ['slot', 'instant', 'table'] as const;
const present = types.filter((t) => numeric.some((g) => g.data.type === t));
---

<div class="mx" data-mx>
  <div class="mx-top">
    <div class="chips" role="group" aria-label={t('catalogue.filter_aria', locale)}>
      <button class="chip" type="button" data-mx-filter="all" aria-pressed="true">{t('global.filter.all', locale)}</button>
      {present.map((categoryType) => (
        <button class="chip" type="button" data-mx-filter={categoryType} aria-pressed="false">{t(`global.game_type.${categoryType}`, locale)}</button>
      ))}
    </div>
    <p class="mx-hint">{t('home.maths.hint', locale)}</p>
  </div>

  <div class="mx-scroll">
    <div class="mx-board" style={`--lanes: ${BANDS.length}`}>
      <div class="mx-labels" aria-hidden="true">
        {[...BANDS].reverse().map((b) => (
          <span class={`mx-lane-label mx-lane-label--${b}`}>
            {b === 'very_high' && <small>{t('home.maths.volatility_axis', locale)}</small>}
            <strong>{LANE_LABEL[b]}</strong>
          </span>
        ))}
        <span class="mx-rtp-axis">{t('global.label.rtp', locale)} <small>(Published)</small></span>
      </div>

      <div class="mx-track">
        {[...BANDS].reverse().map((b) => <div class={`mx-lane mx-lane--${b}`}></div>)}

        {ticks.map((t) => (
          <span class="mx-tick" style={`left: ${xOf(t)}%`}>
            <b class="tnum">{Math.round(t * 100)}%</b>
          </span>
        ))}

        {placed.filter((p) => p.spans).map((p) => (
          <span
            class="mx-bracket"
            style={`left: ${p.x}%; --from: ${p.from}; --to: ${p.to};`}
            aria-hidden="true"
          ></span>
        ))}

        <ul class="mx-marks">
          {placed.map((p) => {
            const localized = getLocalizedGame(p.game, locale);
            return (
            <li
              class="mx-mark"
              data-type={p.game.data.type}
              data-row={p.row}
              style={`left: ${p.x}%; --lane: ${p.lane}; --row: ${p.row};`}
            >
              <a
                class="mx-dot"
                href={localizePath(`/portfolio/${p.game.id}`, locale)}
                data-name={localized.name}
                data-type={t(`global.game_type.${p.game.data.type}_single`, locale)}
                data-rtp={fmtRtp(p.game.data.specs.rtp)}
                data-vol={fmtVol(p.game.data.specs.volatility)}
                data-max={maxWin(p.game.data.specs.maxWin) ?? t('global.label.on_request', locale)}
                aria-label={`${localized.name}: ${t('global.label.rtp', locale)} ${fmtRtp(p.game.data.specs.rtp)}, ${t('global.label.volatility', locale)} ${fmtVol(p.game.data.specs.volatility)}`}
              >
                <span class="mx-dot-art">
                  <Image src={p.game.data.card} alt="" width={96} height={96} loading="lazy" />
                </span>
              </a>
            </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>

  <div class="mx-foot">
    <div class="mx-legend-wrap">
      <div class="mx-type-legend">
        <span class="mx-legend-title">{t('global.aria.game_types', locale)}</span>
        <ul class="mx-legend" aria-label={t('global.aria.game_types', locale)}>
          {present.map((categoryType) => (
            <li data-type={categoryType}><i></i>{t(`global.game_type.${categoryType}`, locale)}</li>
          ))}
        </ul>
      </div>
      <span class="mx-legend-separator" aria-hidden="true"></span>
      <div class="mx-legend-adj">
        <i class="adj" aria-hidden="true"></i>
        <span>
          <strong>{t('home.maths.adjustable', locale)}</strong>
          <small>Game can operate across this range</small>
        </span>
      </div>
    </div>
    <p class="mx-caption"><slot name="caption" /></p>
  </div>

  <div class="mx-tip" role="tooltip" hidden data-mx-tip>
    <div class="mx-tip-art"></div>
    <div class="mx-tip-body">
      <b data-tip-name></b>
      <span class="mx-tip-type" data-tip-type></span>
      <dl>
        <div><dt>{t('global.label.rtp', locale)}</dt><dd class="tnum" data-tip-rtp></dd></div>
        <div><dt>{t('global.label.volatility', locale)}</dt><dd data-tip-vol></dd></div>
        <div><dt>{t('global.label.max_win', locale)}</dt><dd class="tnum" data-tip-max></dd></div>
      </dl>
      <span class="mx-tip-go">{t('home.maths.open_game', locale)}</span>
    </div>
  </div>
</div>

<style>
  .mx {
    position: relative;
    background: var(--ink-2); border-radius: var(--radius-l);
    padding: 28px;
    box-shadow: 0 1px 0 rgb(255 240 200 / 0.05) inset, 0 12px 16px rgb(5 4 2 / 0.7);
    --lane-h: 80px; --lane-gap: 6px; --dot: 40px;
  }
  .mx-top { display: flex; flex-wrap: wrap; gap: var(--sp-4) var(--sp-6); align-items: center; justify-content: space-between; }
  .mx-hint { max-width: 56ch; font-size: 13px; line-height: 1.5; color: var(--fg-3); text-align: right; }

  .mx-scroll {
    overflow-x: auto; overscroll-behavior-x: contain; padding-top: 20px;
    scrollbar-width: none;
  }
  .mx-scroll::-webkit-scrollbar { display: none; }
  .mx-board {
    display: grid; grid-template-columns: 144px minmax(0, 1fr); gap: 0 var(--sp-3);
    min-width: 800px; padding-bottom: 48px; position: relative;
  }
  .mx-labels {
    display: flex; flex-direction: column; gap: var(--lane-gap); position: relative;
    height: calc(var(--lanes) * var(--lane-h) + (var(--lanes) - 1) * var(--lane-gap));
  }
  .mx-lane-label {
    display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
    flex: 1 1 0; min-height: 0; gap: 5px;
    padding: 12px 16px; border: 1px solid; border-radius: var(--radius-s);
    text-transform: uppercase; color: var(--on-brand-button);
  }
  .mx-lane-label strong { font-size: 16px; line-height: 20px; font-weight: 650; letter-spacing: 0.01em; }
  .mx-lane-label small { font-size: 10px; line-height: 13px; font-weight: 650; letter-spacing: 0.06em; color: #febd46; }
  .mx-rtp-axis {
    position: absolute; left: 19px; top: calc(100% + 15px);
    font-size: 13px; line-height: 20px; font-weight: 650; color: var(--fg); white-space: nowrap;
  }
  .mx-rtp-axis small { font: inherit; }

  .mx-lane-label--very_high { border-color: #40100d; background: linear-gradient(90deg, #70100c, rgb(33 17 18 / 0.5)); }
  .mx-lane-label--high { border-color: #472d0d; background: linear-gradient(90deg, #ac5303, rgb(47 32 11 / 0.5)); }
  .mx-lane-label--medium { border-color: #06314f; background: linear-gradient(90deg, #004e9c, rgb(4 36 58 / 0.5)); }
  .mx-lane-label--low { border-color: #102c1a; background: linear-gradient(90deg, #105c27, rgb(11 43 23 / 0.5)); }

  .mx-track {
    position: relative;
    display: flex; flex-direction: column; gap: var(--lane-gap);
    height: calc(var(--lanes) * var(--lane-h) + (var(--lanes) - 1) * var(--lane-gap));
  }
  .mx-lane {
    flex: 0 0 var(--lane-h); border: 1px solid; border-radius: var(--radius-s);
  }
  .mx-lane--very_high { border-color: #551714; background: linear-gradient(90deg, rgb(43 16 17 / 0.5), rgb(33 17 18 / 0.5)); }
  .mx-lane--high { border-color: #724d19; background: linear-gradient(90deg, rgb(58 44 19 / 0.5), rgb(46 34 17 / 0.5)); }
  .mx-lane--medium { border-color: #25658f; background: linear-gradient(90deg, rgb(16 39 53 / 0.5), rgb(13 33 45 / 0.5)); }
  .mx-lane--low { border-color: #2c7844; background: linear-gradient(90deg, rgb(22 59 33 / 0.5), rgb(20 41 27 / 0.5)); }

  .mx-tick {
    position: absolute; top: 0; bottom: 0; width: 1px;
    background: repeating-linear-gradient(to bottom, rgb(244 241 230 / 0.7) 0 4px, transparent 4px 8px);
    pointer-events: none;
  }
  .mx-tick::after { content: ''; position: absolute; left: 0; top: 100%; width: 1px; height: 11px; background: var(--fg); }
  .mx-tick b {
    position: absolute; top: 100%; left: 0; transform: translate(-50%, 14px);
    font-family: 'JetBrains Mono Variable', monospace; font-weight: 500; font-size: 12px; line-height: 18px; color: var(--fg-2);
  }

  .mx-bracket {
    position: absolute; width: 3px; border-radius: 1px;
    background: #febd46; box-shadow: 0 0 2px var(--brand);
    top: calc(var(--from) * (var(--lane-h) + var(--lane-gap)) + var(--lane-h) / 2);
    height: calc((var(--to) - var(--from)) * (var(--lane-h) + var(--lane-gap)));
    transform: translateX(-50%); pointer-events: none;
  }
  .mx-bracket::before, .mx-bracket::after {
    content: ''; position: absolute; left: 50%; width: 11px; height: 2px; background: #febd46;
    transform: translateX(-50%);
  }
  .mx-bracket::before { top: 0; }
  .mx-bracket::after { bottom: 0; }

  .mx-marks { list-style: none; position: absolute; inset: 0; margin: 0; padding: 0; }
  .mx-mark {
    position: absolute; width: var(--dot); height: var(--dot);
    top: calc(var(--lane) * (var(--lane-h) + var(--lane-gap)) + (var(--lane-h) - var(--dot)) / 2 + var(--row) * 36px - 18px);
    transform: translateX(-50%);
    transition: opacity var(--dur-2) var(--ease), filter var(--dur-2) var(--ease);
  }
  .mx-dot {
    display: block; width: var(--dot); height: var(--dot); border-radius: var(--radius-pill);
    overflow: hidden; background: var(--ink-3);
    box-shadow: 0 0 0 2.5px var(--ring, var(--fg-3)), 0 8px 18px -8px rgb(5 4 2 / 0.9);
    transition: transform var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease);
  }
  .mx-dot-art { display: block; width: 100%; height: 100%; }
  .mx-dot-art :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mx-mark[data-type='slot'] { --ring: #feffff; }
  .mx-mark[data-type='instant'] { --ring: #05e3e4; }
  .mx-mark[data-type='table'] { --ring: var(--tint-lemon); }
  .mx-mark[data-type='instant'] .mx-dot {
    width: 28px; height: 28px; margin: 6px; border-radius: 2px;
    transform: rotate(45deg); box-shadow: 0 0 0 2.5px var(--ring), 0 0 8.4px var(--ring), 0 8px 18px -8px rgb(5 4 2 / 0.9);
  }
  .mx-mark[data-type='instant'] .mx-dot-art {
    width: var(--dot); height: var(--dot); transform: translate(-6px, -6px) rotate(-45deg) scale(1.03);
  }
  .mx-dot:hover, .mx-dot:focus-visible { transform: scale(1.22); box-shadow: 0 0 0 3px var(--brand), 0 14px 28px -10px rgb(5 4 2 / 0.95); z-index: 2; }
  .mx-mark[data-type='instant'] .mx-dot:hover,
  .mx-mark[data-type='instant'] .mx-dot:focus-visible { transform: rotate(45deg) scale(1.22); }
  .mx-mark:has(.mx-dot:hover), .mx-mark:has(.mx-dot:focus-visible) { z-index: 5; }

  /* highlight, never hide */
  .mx[data-active]:not([data-active='all']) .mx-mark:not([data-type]) {}
  .mx[data-active='slot'] .mx-mark:not([data-type='slot']),
  .mx[data-active='instant'] .mx-mark:not([data-type='instant']),
  .mx[data-active='table'] .mx-mark:not([data-type='table']) { opacity: 0.22; filter: grayscale(1); }

  .mx-foot {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, 492px); gap: var(--sp-6);
    align-items: center; padding: var(--sp-4) 18px; margin-top: var(--sp-3);
    background: var(--ink-3); border: 1px solid #40403b; border-radius: 16px;
  }
  .mx-legend-wrap { display: flex; align-items: stretch; min-width: 0; }
  .mx-type-legend { display: flex; flex-direction: column; justify-content: center; gap: 7px; }
  .mx-legend-title { font-size: 13px; line-height: 20px; font-weight: 550; color: var(--on-brand-button); }
  .mx-legend { list-style: none; display: flex; flex-wrap: wrap; gap: 10px var(--sp-5); font-size: 12.5px; color: var(--fg-2); }
  .mx-legend li { display: inline-flex; align-items: center; gap: 9px; min-height: 20px; white-space: nowrap; }
  .mx-legend i { width: 14px; height: 14px; border-radius: 50%; background: var(--ink-3); box-shadow: 0 0 0 2px var(--fg-3); }
  .mx-legend li[data-type='slot'] i { box-shadow: 0 0 0 2px #feffff, 0 0 5px #feffff; }
  .mx-legend li[data-type='instant'] i { border-radius: 1px; transform: rotate(45deg); box-shadow: 0 0 0 2px #05e3e4, 0 0 8.4px #05e3e4; }
  .mx-legend li[data-type='table'] i { box-shadow: 0 0 0 2px var(--tint-lemon); }
  .mx-legend-separator { width: 1px; margin: 0 var(--sp-5); background: rgb(246 203 149 / 0.55); }
  .mx-legend-adj { display: flex; align-items: center; gap: var(--sp-4); min-width: 250px; }
  .mx-legend-adj i.adj { position: relative; width: 3px; height: 48px; border-radius: 1px; background: #febd46; box-shadow: 0 0 2px var(--brand); flex: none; }
  .mx-legend-adj i.adj::before, .mx-legend-adj i.adj::after {
    content: ''; position: absolute; left: 50%; width: 11px; height: 2px; background: #febd46; transform: translateX(-50%);
  }
  .mx-legend-adj i.adj::before { top: 0; }
  .mx-legend-adj i.adj::after { bottom: 0; }
  .mx-legend-adj span { display: flex; flex-direction: column; justify-content: center; gap: 3px; }
  .mx-legend-adj strong { font-size: 13px; line-height: 20px; font-weight: 550; color: var(--on-brand-button); white-space: nowrap; }
  .mx-legend-adj small { font-size: 10px; line-height: 16px; font-weight: 500; color: #9ca9b6; white-space: nowrap; }
  .mx-caption { font-size: 12px; line-height: 20px; font-weight: 500; color: #9ca9b6; max-width: 60ch; }


  .mx-tip {
    position: absolute; z-index: 20; width: 300px; pointer-events: none;
    display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 0;
    background: var(--ink-0); border: 1px solid var(--line-2); border-radius: var(--radius);
    box-shadow: var(--shadow-2); overflow: hidden;
  }
  .mx-tip[hidden] { display: none; }
  .mx-tip-art { background: var(--ink-3); }
  .mx-tip-art :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mx-tip-body { padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }
  .mx-tip-body b { font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-weight: 400; font-size: 1.15rem; line-height: 1.05; color: var(--fg); }
  .mx-tip-type { font-family: 'JetBrains Mono Variable', monospace; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-3); }
  .mx-tip dl { margin: 6px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 10px; }
  .mx-tip dl div:first-child { grid-column: 1 / -1; }
  .mx-tip dt { font-family: 'JetBrains Mono Variable', monospace; font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-3); }
  .mx-tip dd { margin: 0; font-size: 13px; color: var(--fg); }
  .mx-tip-go { margin-top: 6px; font-size: 12px; color: var(--peach); }

  @media (hover: none) {
    .mx-tip { position: fixed; left: var(--sp-4); right: var(--sp-4); bottom: var(--sp-4); width: auto; pointer-events: auto; }
  }
  @media (max-width: 768px) {
    .mx { padding: var(--sp-4); --lane-h: 68px; --lane-gap: 5px; --dot: 36px; }
    .mx-scroll { margin-inline: calc(var(--sp-4) * -1); padding-inline: var(--sp-4); }
    .mx-board { grid-template-columns: 112px minmax(0, 1fr); min-width: 780px; }
    .mx-lane-label { padding: 8px 10px; gap: 3px; }
    .mx-lane-label strong { font-size: 13px; }
    .mx-lane-label small { font-size: 9px; line-height: 11px; }
    .mx-rtp-axis { font-size: 12px; }
    .mx-mark { top: calc(var(--lane) * (var(--lane-h) + var(--lane-gap)) + (var(--lane-h) - var(--dot)) / 2 + var(--row) * 30px - 15px); }
    .mx-mark[data-type='instant'] .mx-dot { width: 26px; height: 26px; margin: 5px; }
    .mx-mark[data-type='instant'] .mx-dot-art { transform: translate(-5px, -5px) rotate(-45deg) scale(1.03); }
    .mx-hint { display: none; }
    .mx-foot { grid-template-columns: 1fr; gap: var(--sp-4); }
    .mx-caption { max-width: none; }
  }
  @media (max-width: 480px) {
    .mx-top .chips { flex-wrap: nowrap; width: 100%; overflow-x: auto; padding-bottom: 2px; }
    .mx-foot { padding: var(--sp-4); gap: var(--sp-4); }
    .mx-legend-wrap { flex-wrap: wrap; gap: var(--sp-4); }
    .mx-type-legend { width: 100%; gap: var(--sp-2); }
    .mx-legend-separator { display: none; }
    .mx-legend-adj { width: 100%; min-width: 0; padding-top: var(--sp-4); border-top: 1px solid var(--line); }
    .mx-legend-adj small { white-space: normal; }
    .mx-caption { padding-top: var(--sp-4); border-top: 1px solid var(--line); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mx-mark, .mx-dot { transition: none; }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-mx]')) {
    const chips = root.querySelectorAll<HTMLButtonElement>('[data-mx-filter]');
    const tip = root.querySelector<HTMLElement>('[data-mx-tip]')!;
    const art = tip.querySelector<HTMLElement>('.mx-tip-art')!;
    const set = (sel: string, v: string) => (tip.querySelector<HTMLElement>(sel)!.textContent = v);
    const touch = window.matchMedia('(hover: none)').matches;

    root.dataset.active = 'all';
    for (const c of chips) {
      c.addEventListener('click', () => {
        root.dataset.active = c.dataset.mxFilter!;
        for (const o of chips) o.setAttribute('aria-pressed', String(o === c));
      });
    }

    function show(dot: HTMLAnchorElement) {
      set('[data-tip-name]', dot.dataset.name!);
      set('[data-tip-type]', dot.dataset.type!);
      set('[data-tip-rtp]', dot.dataset.rtp!);
      set('[data-tip-vol]', dot.dataset.vol!);
      set('[data-tip-max]', dot.dataset.max!);
      art.replaceChildren(dot.querySelector('img')!.cloneNode(true));
      tip.hidden = false;
      if (touch) return;
      // above the game when there is room, otherwise beside it, so the card
      // never sits on top of the neighbouring games
      const r = dot.getBoundingClientRect();
      const b = root.getBoundingClientRect();
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      let left = r.left - b.left + r.width / 2 - w / 2;
      let top = r.top - b.top - h - 12;
      if (top < 4) {
        top = r.top - b.top + r.height / 2 - h / 2;
        left = r.right - b.left + 14;
        if (left + w > b.width - 8) left = r.left - b.left - w - 14;
      }
      left = Math.max(8, Math.min(left, b.width - w - 8));
      top = Math.max(4, top);
      tip.style.left = `${left}px`;
      tip.style.top = `${top}px`;
    }
    const hide = () => (tip.hidden = true);

    let armed: HTMLAnchorElement | null = null;
    for (const dot of root.querySelectorAll<HTMLAnchorElement>('.mx-dot')) {
      dot.addEventListener('mouseenter', () => show(dot));
      dot.addEventListener('mouseleave', hide);
      dot.addEventListener('focus', () => show(dot));
      dot.addEventListener('blur', hide);
      // on touch the first tap shows the figures, the second opens the game
      dot.addEventListener('click', (e) => {
        if (!touch) return;
        if (armed === dot) return;
        e.preventDefault();
        armed = dot;
        show(dot);
      });
    }
    document.addEventListener('click', (e) => {
      if (touch && !(e.target as HTMLElement).closest('.mx-dot')) { armed = null; hide(); }
    });
  }
</script>
