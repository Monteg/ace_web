---
import { getTranslations } from '../../i18n/get-translations';
import { renderMarkdown } from '../../lib/markdown';

interface Props { markdown: string; locale?: string; }
const { markdown, locale = 'en' } = Astro.props;
const t = await getTranslations(locale);
const html = renderMarkdown(markdown);
---

{html && (
  <section class="game-overview" aria-labelledby="game-overview-title">
    <div class="wrap">
      <div class="game-overview__inner">
        <h2 class="d2" id="game-overview-title">{t('game.overview')}</h2>
        <div class="game-overview__copy" set:html={html} />
      </div>
    </div>
  </section>
)}

<style>
  .game-overview { padding-block: var(--section-space-compact) var(--sp-7); }
  .game-overview__inner { display: grid; max-width: 900px; gap: var(--sp-4); }
  .game-overview__copy { display: grid; gap: var(--sp-4); color: var(--fg-2); font-size: var(--step-0); }
  .game-overview__copy :global(p) { max-width: 76ch; }
  .game-overview__copy :global(a) { color: var(--fg); text-underline-offset: 3px; }
</style>
