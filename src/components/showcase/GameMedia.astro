---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';
import DemoEmbed from '../DemoEmbed.astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  id: string;
  name: string;
  demoSrc?: string | null;
  poster: ImageMetadata;
  gallery?: GalleryItem[];
}

const { id, name, demoSrc = null, poster, gallery = [] } = Astro.props;
const hasDemo = Boolean(demoSrc);
const hasGallery = gallery.length > 0;
const hasMultipleGalleryImages = gallery.length > 1;
const switchable = hasDemo && hasGallery;
const playPanelId = `${id}-media-play`;
const galleryPanelId = `${id}-media-gallery`;
---

<div class="game-media" data-game-media>
  {switchable && (
    <div class="media-switch" role="tablist" aria-label={`${name} media`}>
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls={playPanelId}
        data-media-tab="play"
      >
        Play
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls={galleryPanelId}
        data-media-tab="gallery"
      >
        Gallery
      </button>
    </div>
  )}

  {hasDemo && (
    <div
      id={playPanelId}
      class="media-panel"
      role={switchable ? 'tabpanel' : undefined}
      data-media-panel="play"
    >
      <DemoEmbed name={name} src={demoSrc!} poster={poster} />
    </div>
  )}

  {hasGallery && (
    <div
      id={galleryPanelId}
      class="media-panel"
      role={switchable ? 'tabpanel' : undefined}
      data-media-panel="gallery"
      hidden={hasDemo}
    >
      <div
        class="game-gallery"
        data-game-gallery
        tabindex={hasMultipleGalleryImages ? 0 : undefined}
        aria-label={`${name} gallery`}
      >
        <div class="gallery-viewport">
          {gallery.map((item, index) => (
            <figure class="gallery-slide" data-gallery-slide hidden={index !== 0}>
              <Image
                src={item.image}
                alt={item.alt}
                widths={[640, 960, 1400, 1800]}
                sizes="(max-width: 900px) 100vw, 75vw"
                loading="lazy"
              />
            </figure>
          ))}
        </div>

        {hasMultipleGalleryImages && (
          <div class="gallery-controls">
            <button type="button" data-gallery-prev aria-label={`Previous ${name} image`}>
              <Icon name="ph:arrow-left" aria-hidden="true" />
            </button>
            <p class="gallery-count mono" aria-live="polite">
              <span data-gallery-current>1</span>
              <span aria-hidden="true">/</span>
              <span>{gallery.length}</span>
            </p>
            <button type="button" data-gallery-next aria-label={`Next ${name} image`}>
              <Icon name="ph:arrow-right" aria-hidden="true" />
            </button>
          </div>
        )}
      </div>
    </div>
  )}

  {!hasDemo && !hasGallery && (
    <figure class="media-fallback">
      <Image
        src={poster}
        alt={`${name} game artwork`}
        widths={[640, 960, 1400, 1800]}
        sizes="(max-width: 900px) 100vw, 75vw"
        loading="lazy"
      />
    </figure>
  )}
</div>

<style>
  .game-media { min-width: 0; }
  .media-switch {
    display: inline-flex;
    gap: 3px;
    margin-bottom: var(--sp-4);
    padding: 4px;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }
  .media-switch button {
    min-height: 42px;
    padding: 9px 20px;
    color: var(--fg-2);
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif;
    font-size: 1rem;
    letter-spacing: var(--button-label-spacing);
    transition: color var(--dur-1), background var(--dur-1), transform var(--dur-1) var(--ease);
  }
  .media-switch button:hover { color: var(--fg); }
  .media-switch button[aria-selected='true'] {
    color: var(--on-brand-button);
    background: var(--brand);
  }
  .media-switch button:active { transform: scale(0.98); }
  .media-panel[hidden] { display: none; }

  .game-gallery,
  .media-fallback {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .gallery-viewport,
  .gallery-slide {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .gallery-slide[hidden] { display: none; }
  .gallery-slide :global(img),
  .media-fallback :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-slide:not([hidden]) { animation: gallery-in var(--dur-2) var(--ease-out); }
  @keyframes gallery-in {
    from { opacity: 0; transform: scale(0.985); }
    to { opacity: 1; transform: none; }
  }
  .gallery-controls {
    position: absolute;
    right: var(--sp-4);
    bottom: var(--sp-4);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 4px;
    color: var(--fg);
    background: rgb(17 17 16 / 0.76);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(10px);
  }
  .gallery-controls button {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    padding: 0;
    color: var(--fg);
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: color var(--dur-1), background var(--dur-1), transform var(--dur-1) var(--ease);
  }
  .gallery-controls button:hover { color: var(--on-brand-button); background: var(--brand); }
  .gallery-controls button:active { transform: scale(0.94); }
  .gallery-controls svg { width: 18px; height: 18px; stroke-width: var(--button-icon-stroke); }
  .gallery-count {
    display: flex;
    min-width: 46px;
    justify-content: center;
    gap: 5px;
    color: var(--fg-2);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  @media (max-width: 560px) {
    .media-switch { width: 100%; }
    .media-switch button { flex: 1; }
    .gallery-controls { right: var(--sp-3); bottom: var(--sp-3); }
  }
  @media (prefers-reduced-motion: reduce) {
    .media-switch button,
    .gallery-controls button { transition: none; }
    .gallery-slide:not([hidden]) { animation: none; }
  }
</style>

<script>
  for (const media of document.querySelectorAll<HTMLElement>('[data-game-media]')) {
    const tabs = Array.from(media.querySelectorAll<HTMLButtonElement>('[data-media-tab]'));
    const panels = Array.from(media.querySelectorAll<HTMLElement>('[data-media-panel]'));

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const mode = tab.dataset.mediaTab;
        for (const candidate of tabs) {
          candidate.setAttribute('aria-selected', String(candidate === tab));
        }
        for (const panel of panels) {
          panel.hidden = panel.dataset.mediaPanel !== mode;
        }
      });
    }
  }

  for (const gallery of document.querySelectorAll<HTMLElement>('[data-game-gallery]')) {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    if (slides.length < 2) continue;

    const currentLabel = gallery.querySelector<HTMLElement>('[data-gallery-current]');
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    let current = 0;
    let pointerStartX: number | null = null;

    const show = (nextIndex: number) => {
      current = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => (slide.hidden = index !== current));
      if (currentLabel) currentLabel.textContent = String(current + 1);
    };

    previous?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));
    gallery.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });
    gallery.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') pointerStartX = event.clientX;
    });
    gallery.addEventListener('pointerup', (event) => {
      if (pointerStartX === null) return;
      const travel = event.clientX - pointerStartX;
      pointerStartX = null;
      if (Math.abs(travel) < 40) return;
      show(current + (travel < 0 ? 1 : -1));
    });
    gallery.addEventListener('pointercancel', () => (pointerStartX = null));
  }
</script>
