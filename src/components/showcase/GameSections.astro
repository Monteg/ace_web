---
import { Image } from 'astro:assets';
import type { GameSection } from '../../lib/content-source';
import { renderMarkdown } from '../../lib/markdown';

interface Props { sections: GameSection[] }
const { sections } = Astro.props;
const prepared = sections.map((section) => ({ ...section, html: renderMarkdown(section.bodyMarkdown) }));
---

{prepared.map((section) => (
  <section class:list={['cms-section', `cms-section--${section.type}`, `cms-section--${section.stylePreset}`, 'rv']}>
    {(section.heading || section.html) && (
      <div class="cms-section-copy">
        {section.heading && <h2 class="d2">{section.heading}</h2>}
        {section.html && <div class="cms-markdown" set:html={section.html} />}
      </div>
    )}
    {section.media && <Image class="cms-section-media" src={section.media} alt="" widths={[480, 760, 1100]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" />}
    {section.type === 'feature_grid' && section.items.length > 0 && (
      <div class="cms-feature-grid">
        {section.items.map((item) => (
          <article>
            {item.icon && <Image src={item.icon} alt="" width={48} height={48} loading="lazy" />}
            {item.image && <Image src={item.image} alt="" widths={[320, 480]} sizes="(max-width: 760px) 100vw, 33vw" loading="lazy" />}
            {item.title && <h3 class="d4">{item.title}</h3>}
            {item.text && <p>{item.text}</p>}
          </article>
        ))}
      </div>
    )}
    {section.type === 'bullet_list' && section.items.length > 0 && (
      <ul class="cms-bullets">{section.items.map((item) => <li>{item.title && <strong>{item.title}</strong>}{item.text}</li>)}</ul>
    )}
  </section>
))}

<style>
  .cms-section { display: grid; gap: var(--sp-5); margin-top: var(--section-space-compact); }
  .cms-section-copy { display: grid; max-width: 72ch; gap: var(--sp-4); }
  .cms-markdown { display: grid; gap: var(--sp-4); color: var(--fg-2); }
  .cms-markdown :global(h2), .cms-markdown :global(h3) { color: var(--fg); font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-weight: 400; }
  .cms-section--wide .cms-section-copy { max-width: 88ch; }
  .cms-section--compact { margin-top: var(--sp-6); }
  .cms-section--media_text { grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr); align-items: center; }
  .cms-section--media_right .cms-section-media { grid-column: 2; grid-row: 1; }
  .cms-section--media_left .cms-section-media { grid-column: 1; grid-row: 1; }
  .cms-section--media_left .cms-section-copy { grid-column: 2; grid-row: 1; }
  .cms-section-media { width: 100%; height: auto; border-radius: var(--radius-l); }
  .cms-feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--sp-4); }
  .cms-feature-grid article { display: grid; align-content: start; gap: var(--sp-3); padding: var(--sp-5); border: 1px solid var(--line); border-radius: var(--radius-l); background: var(--ink-2); }
  .cms-feature-grid article > :global(img) { max-width: 100%; height: auto; }
  .cms-feature-grid p, .cms-bullets { color: var(--fg-2); }
  .cms-bullets { display: grid; gap: var(--sp-3); padding-left: var(--sp-5); }
  .cms-bullets li::marker { color: var(--brand); }
  .cms-bullets strong { display: block; color: var(--fg); }
  @media (max-width: 760px) {
    .cms-section--media_text { grid-template-columns: 1fr; }
    .cms-section--media_left .cms-section-copy,
    .cms-section--media_left .cms-section-media,
    .cms-section--media_right .cms-section-copy,
    .cms-section--media_right .cms-section-media { grid-column: 1; grid-row: auto; }
  }
</style>
