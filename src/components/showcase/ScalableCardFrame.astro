---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
}

const { src } = Astro.props;
const optimizedFrame = await getImage({
  src,
  width: 720,
  format: 'webp',
  quality: 84,
});
const frameStyle = `--card-frame-image: url("${optimizedFrame.src}");`;
---

<div class="scalable-card-frame" aria-hidden="true" style={frameStyle}></div>

<style>
  .scalable-card-frame {
    position: absolute;
    inset: 0;
    border: clamp(22px, 2.3vw, 34px) solid transparent;
    border-image-source: var(--card-frame-image);
    border-image-slice: 4.153% 9.466% fill;
    border-image-width: 1;
    border-image-repeat: stretch;
  }
</style>
