---
import { Icon } from 'astro-icon/components';
import { getTranslations } from '../../i18n/get-translations';

interface Props { name: string; contactHref: string; locale?: string; }
const { name, contactHref, locale = 'en' } = Astro.props;
const t = await getTranslations(locale);
---

<section class="game-feedback" aria-labelledby="game-feedback-title">
  <div class="wrap">
    <div class="game-feedback__panel">
      <div class="game-feedback__copy">
        <p class="eyebrow">{t('game.feedback.eyebrow')}</p>
        <h2 class="d2" id="game-feedback-title">{t('game.feedback.title')}</h2>
        <p>{t('game.feedback.body')}</p>
        <span class="mono">{t('game.feedback.regarding', { name })}</span>
      </div>
      <button class="btn btn-primary" type="button" data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog" hidden>
        {t('game.feedback.cta')}
        <span class="disc" aria-hidden="true"><Icon name="ph:arrow-up-right" /></span>
      </button>
      <noscript><a class="btn btn-primary" href={contactHref}>{t('game.feedback.cta')}</a></noscript>
    </div>
  </div>
</section>

<style>
  .game-feedback { padding-block: var(--section-space-compact); }
  .game-feedback__panel {
    position: relative;
    display: flex;
    min-height: 260px;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-7);
    overflow: hidden;
    padding: clamp(28px, 5vw, 64px);
    background:
      radial-gradient(circle at 82% 20%, rgb(255 86 0 / 0.18), transparent 34%),
      var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-1);
  }
  .game-feedback__panel::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 1px 0 rgb(255 240 200 / 0.05);
  }
  .game-feedback__copy { position: relative; z-index: 1; display: grid; max-width: 740px; gap: var(--sp-3); }
  .game-feedback__copy > p:not(.eyebrow) { color: var(--fg-2); }
  .game-feedback__copy .mono { color: var(--fg-3); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; }
  .game-feedback .btn { position: relative; z-index: 1; flex: none; }

  @media (max-width: 700px) {
    .game-feedback__panel { min-height: 0; align-items: flex-start; flex-direction: column; gap: var(--sp-5); }
    .game-feedback .btn { width: 100%; }
  }
</style>
