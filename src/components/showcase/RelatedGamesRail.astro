---
import GameTile from './GameTile.astro';
import type { GameRecord } from '../../lib/content-source';
import { getTranslations } from '../../i18n/get-translations';

interface Props {
  games: GameRecord[];
  typeLabel: string;
  locale?: string;
}

const { games, typeLabel, locale = 'en' } = Astro.props;
const t = await getTranslations(locale);
const few = games.length < 5;
---

{games.length > 0 && (
  <section class="related-games" aria-labelledby="related-games-title">
    <div class="wrap related-games__heading">
      <h2 class="d2" id="related-games-title">{t('game.more_games.heading', { type: typeLabel })}</h2>
    </div>
    <div class="related-games__viewport">
      <div
        class:list={['related-games__rail', { 'related-games__rail--few': few }]}
        style={`--related-count:${games.length}`}
        role="region"
        aria-label={t('game.more_games.aria', { type: typeLabel })}
        tabindex="0"
      >
        {games.map((game) => <GameTile game={game} locale={locale} />)}
      </div>
    </div>
  </section>
)}

<style>
  .related-games {
    overflow: hidden;
    padding-block: var(--section-space-compact);
    background: linear-gradient(180deg, var(--ink-0), var(--ink));
    border-block: 1px solid var(--line);
  }
  .related-games__heading { margin-bottom: var(--sp-6); }
  .related-games__viewport {
    width: min(100%, var(--maxw));
    margin-inline: auto;
    padding-inline: var(--gutter);
    overflow: visible;
  }
  .related-games__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * var(--sp-4)) / 4.28);
    gap: var(--sp-4);
    overflow-x: auto;
    overflow-y: visible;
    padding: 4px max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))) var(--sp-5) 4px;
    margin-right: calc(-1 * max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter))));
    scroll-padding-inline: 4px;
    scroll-snap-type: x proximity;
    scrollbar-color: var(--line-2) transparent;
    scrollbar-width: thin;
    overscroll-behavior-inline: contain;
  }
  .related-games__rail > :global(*) { scroll-snap-align: start; }
  .related-games__rail--few {
    grid-auto-flow: row;
    grid-auto-columns: auto;
    grid-template-columns: repeat(var(--related-count), minmax(0, 1fr));
    overflow-x: visible;
    margin-right: 0;
    padding-right: 4px;
  }

  @media (max-width: 1024px) {
    .related-games__rail,
    .related-games__rail--few {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: calc((100% - var(--sp-4)) / 2.35);
      overflow-x: auto;
      margin-right: calc(-1 * var(--gutter));
      padding-right: var(--gutter);
    }
  }
  @media (max-width: 600px) {
    .related-games__heading { margin-bottom: var(--sp-5); }
    .related-games__rail,
    .related-games__rail--few { grid-auto-columns: min(82vw, 320px); }
  }
</style>
