---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { CTA } from '../../data/site';
import { TYPE_LABEL } from '../../lib/format';

/**
 * Game page header: the wide banner as a full-bleed ground, the key art as a
 * tilted tile floating over it, and a compact title and action group. The old
 * page was a flat banner with the name on top.
 */
interface Props {
  game: CollectionEntry<'games'>;
  /** Only true when the page below actually renders a demo block (`#demo`). */
  demoAvailable: boolean;
}

const { game, demoAvailable } = Astro.props;
const d = game.data;
const soon = d.status === 'coming_soon';

// The title sits at poster size. A long name at that size runs to three or
// four lines and pushes the figures and the CTAs below the fold, so the size
// is capped per name: Tanker sets at roughly half an em per glyph, and the cap
// is the smaller of "longest word on one line" and "every glyph across two
// lines", as a share of the copy column. Short names never hit the cap.
const words = d.name.trim().split(/\s+/);
const longestWord = Math.max(...words.map((w) => w.length));
const fit = Math.min(2 / longestWord, 3.4 / d.name.length).toFixed(3);
---

<section class="gh" id="top" style={`--gh-fit:${fit}`}>
  <div class="gh-bg" aria-hidden="true">
    <Image
      src={d.hero}
      alt=""
      widths={[1200, 1800, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="wrap gh-wrap">
    <div class="gh-copy">
      <nav class="gh-crumbs" aria-label="Breadcrumb">
        <a href="/games">Games</a>
        <span aria-hidden="true">/</span>
        <a href={`/games?type=${d.type}`}>{TYPE_LABEL[d.type]}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.name}</span>
      </nav>

      <h1 class="gh-title">{d.name}</h1>

      <ul class="gh-pills" aria-label="Game classification">
        <li class={`gh-pill gh-pill--type gh-pill--${d.type}`}>{TYPE_LABEL[d.type]}</li>
        {soon && <li class="gh-pill gh-pill--soon">In development</li>}
      </ul>

      <div class="gh-cta">
        {demoAvailable ? (
          <>
            <a class="btn btn-primary" href="#demo">Play the demo</a>
            <a class="btn btn-ghost" href={CTA.href}>{CTA.label}</a>
          </>
        ) : (
          <a class="btn btn-primary" href={CTA.href}>{CTA.label}</a>
        )}
      </div>
    </div>

    <div class="gh-art" data-gh-art>
      <div class="gh-tile">
        <Image
          src={d.card}
          alt={`${d.name} key art`}
          widths={[420, 640]}
          sizes="(max-width: 992px) 60vw, 380px"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .gh {
    --gh-col: 0.58;
    position: relative; overflow: hidden; padding: 0;
    background: var(--ink-0);
    border-bottom: 1px solid var(--line);
  }

  /* ground: the banner at reduced opacity, then a scrim that is darkest on
     the left where the type sits and fades into the page at the bottom */
  .gh-bg { position: absolute; inset: 0; }
  .gh-bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: 0.55; }
  .gh-bg::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--ink) 30%, transparent) 0%, transparent 28%, transparent 62%, var(--ink) 100%),
      linear-gradient(90deg, var(--ink) 0%, color-mix(in srgb, var(--ink) 86%, transparent) 34%, color-mix(in srgb, var(--ink) 40%, transparent) 66%, color-mix(in srgb, var(--ink) 18%, transparent) 100%);
  }

  .gh-wrap {
    position: relative; z-index: 1; width: 100%;
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center; gap: var(--sp-6);
    min-height: min(66vh, 620px);
    padding-block: var(--sp-6) var(--sp-7);
  }

  .gh-copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-3); }

  .gh-crumbs {
    display: flex; flex-wrap: wrap; gap: var(--sp-2);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-2);
  }
  .gh-crumbs a { text-decoration: none; transition: color var(--dur-1); }
  .gh-crumbs a:hover { color: var(--fg); }
  .gh-crumbs [aria-current] { color: var(--fg); }

  .gh-title {
    margin: 0; color: var(--fg);
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-weight: 400;
    font-size: min(var(--step-5), calc((min(100vw, var(--maxw)) - 2 * var(--gutter)) * var(--gh-col) * var(--gh-fit)));
    line-height: 0.9; letter-spacing: 0.005em; text-wrap: balance;
  }
  .gh-pills { list-style: none; display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .gh-pill {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11.5px; letter-spacing: 0.06em; line-height: 1.3;
    padding: 7px 12px; border-radius: var(--radius-pill);
    border: 1px solid var(--line-2); color: var(--fg-2);
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    backdrop-filter: blur(8px);
  }
  .gh-pill b { color: var(--fg); font-weight: 500; }
  .gh-pill--type { border-color: transparent; color: var(--tint-ink); font-weight: 500; backdrop-filter: none; }
  .gh-pill--slot { background: var(--tint-ice); }
  .gh-pill--instant { background: var(--tint-mint); }
  .gh-pill--table { background: var(--tint-lemon); }
  .gh-pill--soon { background: var(--peach); color: var(--on-brand); border-color: transparent; backdrop-filter: none; }

  .gh-cta { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-2); }

  /* the key art: a tilted portrait tile, lifted off the banner by a warm
     shadow and a faint brand glow behind it; on desktop the script drifts it
     up to 40px as the header scrolls out (see --gh-shift) */
  .gh-art { position: relative; justify-self: end; width: min(340px, 100%); }
  .gh-art::before {
    content: ''; position: absolute; inset: -10% -22% -22%; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--brand) 24%, transparent), transparent 74%);
  }
  .gh-tile {
    position: relative; aspect-ratio: 4 / 5;
    border-radius: var(--radius-l); overflow: hidden;
    background: var(--ink-3); box-shadow: var(--shadow-2);
    transform: rotate(-3deg) translateY(var(--gh-shift, 0px));
    will-change: transform;
  }
  .gh-tile :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .gh-tile::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--fg) 14%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--peach) 35%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gh-tile { animation: gh-rise var(--dur-3) var(--ease-out) backwards; }
    @keyframes gh-rise {
      from { opacity: 0; transform: translateY(28px); }
    }
  }

  @media (max-width: 992px) {
    .gh { --gh-col: 1; }
    .gh-wrap {
      grid-template-columns: minmax(0, 1fr); align-items: start;
      min-height: 0; gap: var(--sp-4);
      padding-block: var(--sp-5) var(--sp-6);
    }
    .gh-art { justify-self: start; width: min(52vw, 320px); }
    .gh-art::before { display: none; }
    .gh-tile { transform: none; will-change: auto; }
  }
  @media (max-width: 560px) {
    .gh-art { width: min(68vw, 280px); }
  }
</style>

<script>
  // Parallax on the key art. There is no scroll listener: an
  // IntersectionObserver switches a requestAnimationFrame loop on only while
  // the header is on screen, and the loop touches nothing on frames where the
  // scroll position did not change. Off entirely under reduced motion and on
  // narrow screens, where the tile sits in the flow below the text.
  (() => {
    const section = document.querySelector<HTMLElement>('.gh');
    const art = section?.querySelector<HTMLElement>('[data-gh-art]');
    if (!section || !art || !('IntersectionObserver' in window)) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 993px)');
    const MAX_SHIFT = 40;

    let raf = 0;
    let lastY = -1;
    let visible = false;

    const frame = () => {
      raf = 0;
      const y = window.scrollY;
      if (y !== lastY) {
        lastY = y;
        const progress = Math.min(1, Math.max(0, y / (section.offsetHeight || 1)));
        art.style.setProperty('--gh-shift', `${(-MAX_SHIFT * progress).toFixed(1)}px`);
      }
      raf = requestAnimationFrame(frame);
    };

    const allowed = () => !reduce.matches && desktop.matches;
    const start = () => {
      if (raf || !allowed()) return;
      lastY = -1;
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };
    const sync = () => {
      if (!allowed()) {
        stop();
        art.style.removeProperty('--gh-shift');
      } else if (visible) {
        start();
      }
    };

    const io = new IntersectionObserver(([entry]) => {
      visible = !!entry?.isIntersecting;
      visible ? start() : stop();
    });
    io.observe(section);

    reduce.addEventListener('change', sync);
    desktop.addEventListener('change', sync);
  })();
</script>
