---
import ContentImage from '../ContentImage.astro';
import type { GameRecord } from '../../lib/content-source';
import { getActiveLocales } from '../../i18n/config';
import { getTranslations } from '../../i18n/get-translations';
import { localePath } from '../../i18n/routes';

interface Props {
  game: GameRecord;
  demoAvailable?: boolean;
  locale?: string;
}

const { game, locale = 'en' } = Astro.props;
const t = await getTranslations(locale);
const locales = await getActiveLocales();
const d = game.data;
const typeLabel = t(`game.type.${d.type}`);
const titleWords = d.name.trim().split(/\s+/);
const titleAccent = titleWords.length > 1 ? titleWords.pop() : null;
const titleLead = titleWords.join(' ');
---

<section class="game-detail-hero" id="top" aria-labelledby="game-detail-title">
  <div class="game-detail-hero__art" aria-hidden="true">
    <ContentImage
      src={d.hero}
      alt=""
      widths={[960, 1440, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="wrap game-detail-hero__inner">
    <div class="game-detail-hero__copy">
      <nav class="game-detail-hero__crumbs" aria-label={t('global.breadcrumb')}>
        <a href={localePath('/games', locale, locales)}>{t('header.games')}</a>
        <span aria-hidden="true">/</span>
        <a href={`${localePath('/games', locale, locales)}?type=${d.type}#games`}>{typeLabel}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.name}</span>
      </nav>

      <h1 class="game-detail-hero__title" id="game-detail-title">
        {titleAccent ? <><span>{titleLead}</span> <em>{titleAccent}</em></> : d.name}
      </h1>

      <div class="game-detail-hero__summary">
        <span class:list={['game-detail-hero__type', `game-detail-hero__type--${d.type}`]}>{typeLabel}</span>
        {d.status === 'coming_soon' && <span class="game-detail-hero__status">{t('game.status.coming_soon')}</span>}
        <p>{d.shortDescription}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .game-detail-hero {
    position: relative;
    min-height: clamp(286px, 28vw, 360px);
    overflow: hidden;
    padding: 0;
    background: var(--ink-0);
    border-bottom: 1px solid var(--line);
  }
  .game-detail-hero__art { position: absolute; inset: 0; }
  .game-detail-hero__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
    opacity: 0.78;
    transform: scale(1.01);
  }
  .game-detail-hero__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(12 12 11 / 0.98) 0%, rgb(12 12 11 / 0.91) 28%, rgb(12 12 11 / 0.38) 61%, rgb(12 12 11 / 0.15) 100%),
      linear-gradient(180deg, rgb(12 12 11 / 0.24), transparent 45%, rgb(12 12 11 / 0.82));
  }
  .game-detail-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: inherit;
    align-items: center;
    padding-block: var(--sp-5) var(--sp-6);
  }
  .game-detail-hero__copy {
    display: grid;
    width: min(760px, 65%);
    gap: var(--sp-4);
  }
  .game-detail-hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    color: var(--fg-2);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .game-detail-hero__crumbs a { text-decoration: none; transition: color var(--dur-1); }
  .game-detail-hero__crumbs a:hover { color: var(--fg); }
  .game-detail-hero__crumbs [aria-current='page'] { color: var(--fg); }
  .game-detail-hero__title {
    max-width: 11ch;
    margin: 0;
    color: var(--fg);
    font-family: Tanker, 'Tanker Fallback', 'Arial Narrow', sans-serif;
    font-size: clamp(3.4rem, 6.25vw, 6rem);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 0.86;
    text-wrap: balance;
    text-transform: uppercase;
  }
  .game-detail-hero__title em { color: var(--brand); font-style: normal; }
  .game-detail-hero__summary {
    display: flex;
    max-width: 720px;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .game-detail-hero__summary p {
    max-width: 52ch;
    color: var(--fg-2);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .game-detail-hero__type,
  .game-detail-hero__status {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    color: var(--tint-ink);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }
  .game-detail-hero__type--slot { background: var(--tint-ice); }
  .game-detail-hero__type--instant { background: var(--tint-mint); }
  .game-detail-hero__type--crash { background: var(--tint-pink); }
  .game-detail-hero__type--table { background: var(--tint-lemon); }
  .game-detail-hero__status { background: var(--peach); }

  @media (prefers-reduced-motion: no-preference) {
    .game-detail-hero__art :global(img) { animation: game-hero-settle 900ms var(--ease-out) both; }
    .game-detail-hero__copy { animation: game-copy-settle 650ms 90ms var(--ease-out) both; }
    @keyframes game-hero-settle { from { opacity: 0.58; transform: scale(1.045); } }
    @keyframes game-copy-settle { from { opacity: 0; transform: translateY(14px); } }
  }

  @media (max-width: 768px) {
    .game-detail-hero { min-height: 330px; }
    .game-detail-hero__copy { width: min(100%, 620px); }
    .game-detail-hero__art :global(img) { object-position: 64% center; opacity: 0.66; }
    .game-detail-hero__art::after {
      background:
        linear-gradient(90deg, rgb(12 12 11 / 0.97), rgb(12 12 11 / 0.72) 68%, rgb(12 12 11 / 0.35)),
        linear-gradient(180deg, rgb(12 12 11 / 0.18), transparent 35%, rgb(12 12 11 / 0.9));
    }
  }
  @media (max-width: 480px) {
    .game-detail-hero { min-height: 350px; }
    .game-detail-hero__inner { align-items: flex-end; }
    .game-detail-hero__title { max-width: 9ch; font-size: clamp(3.1rem, 16vw, 4.2rem); }
    .game-detail-hero__summary { align-items: flex-start; }
    .game-detail-hero__summary p { flex-basis: 100%; }
  }
</style>
