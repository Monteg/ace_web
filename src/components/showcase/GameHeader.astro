---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localeFromPath, localizePath, t } from '../../lib/i18n';
import { getLocalizedGame } from '../../lib/localized-games';
import SpecStrip from './SpecStrip.astro';

interface Props {
  game: CollectionEntry<'games'>;
  demoAvailable: boolean;
}

const { game, demoAvailable } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
const d = getLocalizedGame(game, locale);
const soon = d.status === 'coming_soon';
const preview = !soon && !demoAvailable;
const typeLabel = t(`global.game_type.${d.type}_single`, locale);
const titleWords = d.name.trim().split(/\s+/u);
const titleAccent = titleWords.length > 1 ? titleWords.pop() ?? '' : '';
const titleLead = titleWords.join(' ') || d.name;
const longestWord = Math.max(...d.name.trim().split(/\s+/u).map((word) => word.length));
const fit = Math.min(2 / longestWord, 3.5 / d.name.length).toFixed(3);
---

<section class="gh" id="top" style={`--gh-fit:${fit}`}>
  <div class="gh-bg" aria-hidden="true">
    <Image
      src={d.hero}
      alt=""
      widths={[960, 1440, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="wrap gh-wrap">
    <div class="gh-copy">
      <nav class="gh-crumbs" aria-label={t('game.detail.breadcrumb_aria', locale)}>
        <a href={localizePath('/games', locale)}>{t('game.detail.breadcrumb.games', locale)}</a>
        <span aria-hidden="true">/</span>
        <a href={`${localizePath('/games', locale)}?type=${d.type}`}>{typeLabel}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.name}</span>
      </nav>

      <h1 class="gh-title">
        <span>{titleLead}</span>
        {titleAccent && <em>{titleAccent}</em>}
      </h1>

      <div class="gh-summary">
        <span class:list={['gh-type', `gh-type--${d.type}`]}>{typeLabel}</span>
        <p>{d.shortDescription}</p>
        {soon && <span class="gh-status">{t('game.detail.in_development', locale)}</span>}
        {preview && <span class="gh-status gh-status--preview">{t('global.label.preview', locale)}</span>}
      </div>
    </div>

    <div class="gh-stats" aria-label={t('game.detail.specs_aria', locale, { name: d.name })}>
      <SpecStrip game={game} variant="hero" />
    </div>
  </div>
</section>

<style>
  .gh {
    --gh-col: 0.58;
    position: relative;
    overflow: hidden;
    padding: 0;
    background: var(--ink-0);
    border-bottom: 1px solid var(--line);
  }
  .gh-bg { position: absolute; inset: 0; }
  .gh-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    transform-origin: center;
    opacity: 0.88;
  }
  .gh-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(11 13 14 / 0.1) 0%, rgb(11 13 14 / 0.08) 44%, var(--ink) 100%),
      linear-gradient(90deg, rgb(10 12 13 / 0.97) 0%, rgb(10 12 13 / 0.9) 30%, rgb(10 12 13 / 0.44) 59%, rgb(10 12 13 / 0.08) 100%);
  }
  .gh-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: clamp(330px, 29vw, 410px);
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(34px, 4vw, 52px) 116px;
  }
  .gh-copy {
    display: flex;
    width: min(72%, 900px);
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
  }
  .gh-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    color: var(--fg-2);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .gh-crumbs a { text-decoration: none; transition: color var(--dur-1); }
  .gh-crumbs a:hover { color: var(--fg); }
  .gh-crumbs [aria-current] { color: var(--fg); }
  .gh-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.16em;
    margin: 0;
    color: var(--fg);
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif;
    font-size: min(clamp(3.4rem, 6.1vw, 6.7rem), calc((min(100vw, var(--maxw)) - 2 * var(--gutter)) * var(--gh-col) * var(--gh-fit)));
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .gh-title em { color: var(--brand); font-style: normal; }
  .gh-summary {
    display: flex;
    width: min(100%, 860px);
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
  }
  .gh-summary p {
    display: -webkit-box;
    min-width: 0;
    max-width: 72ch;
    flex: 1 1 auto;
    overflow: hidden;
    margin: 0;
    color: var(--fg-2);
    font-size: 14px;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .gh-type,
  .gh-status {
    flex: 0 0 auto;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    color: var(--tint-ink);
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .gh-type--slot { background: var(--tint-ice); }
  .gh-type--instant { background: var(--tint-mint); }
  .gh-type--table { background: var(--tint-lemon); }
  .gh-status { color: var(--on-brand-button); background: var(--brand); }
  .gh-status--preview { color: var(--fg); background: rgb(17 17 16 / 0.72); border: 1px solid var(--line-2); }
  .gh-stats {
    position: absolute;
    right: var(--gutter);
    bottom: var(--sp-4);
    left: var(--gutter);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gh-copy { animation: gh-copy-in 600ms var(--ease-out) both; }
    .gh-stats { animation: gh-stats-in 660ms 90ms var(--ease-out) both; }
    @keyframes gh-copy-in { from { opacity: 0; transform: translateY(14px); } }
    @keyframes gh-stats-in { from { opacity: 0; transform: translateY(10px); } }
  }

  @media (max-width: 992px) {
    .gh { --gh-col: 0.78; }
    .gh-bg::after {
      background:
        linear-gradient(180deg, rgb(10 12 13 / 0.14), rgb(10 12 13 / 0.5) 52%, var(--ink) 100%),
        linear-gradient(90deg, rgb(10 12 13 / 0.94), rgb(10 12 13 / 0.62) 62%, rgb(10 12 13 / 0.22));
    }
    .gh-wrap { min-height: 0; padding-block: var(--sp-6); gap: var(--sp-6); }
    .gh-copy { width: min(82%, 660px); padding-block: var(--sp-4); }
    .gh-stats { position: relative; inset: auto; }
  }
  @media (max-width: 640px) {
    .gh { --gh-col: 1; }
    .gh-bg::after {
      background:
        linear-gradient(180deg, rgb(10 12 13 / 0.34), rgb(10 12 13 / 0.6) 42%, var(--ink) 78%),
        linear-gradient(90deg, rgb(10 12 13 / 0.94), rgb(10 12 13 / 0.54));
    }
    .gh-copy { width: 100%; padding-block: var(--sp-3) 0; }
    .gh-title { font-size: min(clamp(3.2rem, 16vw, 5.4rem), calc((100vw - 2 * var(--gutter)) * var(--gh-fit))); }
    .gh-summary { width: 100%; flex-wrap: wrap; align-items: flex-start; }
    .gh-summary p { flex: 1 1 calc(100% - 72px); max-width: none; font-size: 13px; }
  }
</style>
