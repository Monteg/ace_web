---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { bet, maxWin, rtp, volatility, type Volatility } from '../../lib/format';
import { localeFromPath, t } from '../../lib/i18n';
import { getLocalizedGame } from '../../lib/localized-games';

/**
 * The six figures a buyer scans first, in one strip under the header.
 * Replaces the 3x2 spec cards: no boxes, hairlines only, one row on desktop.
 */
interface Props {
  game: CollectionEntry<'games'>;
  variant?: 'strip' | 'sidebar' | 'hero';
}

const { game, variant = 'strip' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
const s = getLocalizedGame(game, locale).specs;

type Cell = {
  icon: string;
  tint: 'mint' | 'ice' | 'lemon' | 'peach' | 'sky' | 'pink';
  label: string;
  value: string | null;
  meter?: boolean;
};

// The labels live here and the values come from the record: on the old CMS
// both were free text and 14 of 24 games had them swapped.
const cells: Cell[] = [
  { icon: 'ph:percent', tint: 'mint', label: t('global.label.rtp', locale), value: rtp(s.rtp) },
  { icon: 'ph:wave-sine', tint: 'ice', label: t('global.label.volatility', locale), value: volatility(s.volatility), meter: true },
  { icon: 'ph:trend-up', tint: 'lemon', label: t('global.label.max_win', locale), value: maxWin(s.maxWin) },
  { icon: 'ph:coins', tint: 'peach', label: t('global.label.bet_range', locale), value: bet(s.bet) },
  { icon: 'ph:grid-four', tint: 'sky', label: t('global.label.layout', locale), value: s.layout ?? null },
  { icon: 'ph:sparkle', tint: 'pink', label: t('global.label.main_feature', locale), value: s.mainFeature ?? null },
];

// Volatility as a meter, the way every competitor's catalogue shows it. A bar
// is lit for each band the game runs in, so a two-mode game lights two bars.
const BANDS: Volatility[] = ['low', 'medium', 'high', 'very_high'];
const lit = new Set<Volatility>(s.volatility);
---

<dl class={`ss ss--${variant}`}>
  {cells.map((c) => (
    <div class="ss-cell">
      <dt class="ss-head">
        <span class={`tile tile--${c.tint}`} aria-hidden="true"><Icon name={c.icon} /></span>
        <span class="ss-label">{c.label}</span>
      </dt>
      <dd class="ss-value">
        <span class="ss-figure tnum">{c.value ? c.value : <span class="need">{t('global.label.on_request', locale)}</span>}</span>
        {c.meter && (
          <span class="ss-meter" aria-hidden="true">
            {BANDS.map((b) => <i class={`ss-bar${lit.has(b) ? ' is-on' : ''}`} />)}
          </span>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .ss {
    margin: 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px;
    background: var(--line);
    border-radius: var(--radius-l); overflow: hidden;
  }
  .ss-cell {
    min-width: 0; background: var(--ink-2);
    padding: var(--sp-5);
    display: flex; flex-direction: column; gap: var(--sp-4);
  }
  .ss-head { display: flex; align-items: center; gap: var(--sp-3); }
  .ss-label {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 10.5px; letter-spacing: 0.11em; text-transform: uppercase; color: var(--fg-3);
  }
  .ss-value {
    margin: auto 0 0; display: flex; flex-direction: column; gap: var(--sp-3);
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-weight: 400;
    font-size: var(--step-2); line-height: 1.02; color: var(--fg);
  }
  .ss-figure { display: block; text-wrap: balance; overflow-wrap: anywhere; }

  .ss-meter { display: flex; align-items: flex-end; gap: var(--sp-1); height: 14px; }
  .ss-bar { display: block; width: 18px; border-radius: 2px; background: var(--line-2); }
  .ss-bar:nth-child(1) { height: 5px; }
  .ss-bar:nth-child(2) { height: 8px; }
  .ss-bar:nth-child(3) { height: 11px; }
  .ss-bar:nth-child(4) { height: 14px; }
  .ss-bar.is-on { background: var(--brand); }

  .ss.ss--sidebar { grid-template-columns: minmax(0, 1fr); }
  .ss.ss--sidebar .ss-cell {
    display: grid;
    grid-template-columns: minmax(112px, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
  }
  .ss.ss--sidebar .ss-value {
    margin: 0;
    align-items: flex-start;
    font-size: var(--step-1);
  }
  .ss.ss--sidebar .ss-meter { height: 11px; }
  .ss.ss--sidebar .ss-bar { width: 14px; }

  .ss.ss--hero {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    background: color-mix(in srgb, var(--fg) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
    box-shadow: var(--shadow-1);
    backdrop-filter: blur(18px);
  }
  .ss.ss--hero .ss-cell {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: var(--sp-3);
    row-gap: 2px;
    min-height: 78px;
    padding: var(--sp-3) var(--sp-4);
    background: color-mix(in srgb, var(--ink-2) 82%, transparent);
  }
  .ss.ss--hero .ss-head { display: contents; }
  .ss.ss--hero .ss-head .tile {
    grid-column: 1;
    grid-row: 1 / 3;
    width: 34px;
    height: 34px;
    color: var(--brand);
    background: transparent;
  }
  .ss.ss--hero .ss-head .tile :global(svg) { width: 24px; height: 24px; }
  .ss.ss--hero .ss-label {
    grid-column: 2;
    grid-row: 2;
    color: var(--fg-3);
    font-size: 9.5px;
    letter-spacing: 0.08em;
  }
  .ss.ss--hero .ss-value {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    flex-direction: row;
    align-items: center;
    gap: var(--sp-2);
    font-family: 'Inter Variable', sans-serif;
    font-size: clamp(0.78rem, 1vw, 0.92rem);
    font-weight: 650;
    line-height: 1.2;
  }
  .ss.ss--hero .ss-meter { height: 11px; gap: 2px; }
  .ss.ss--hero .ss-bar { width: 4px; }

  @media (max-width: 992px) {
    .ss { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ss.ss--sidebar { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ss.ss--sidebar .ss-cell {
      display: flex;
      align-items: flex-start;
      padding: var(--sp-4);
    }
    .ss.ss--hero { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ss.ss--hero .ss-cell {
      display: grid;
      align-items: center;
      padding: var(--sp-3) var(--sp-4);
    }
  }
  @media (max-width: 560px) {
    .ss { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ss.ss--sidebar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ss.ss--hero { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ss-cell { padding: var(--sp-4); }
    .ss.ss--hero .ss-cell { min-height: 72px; padding: var(--sp-3); }
  }
</style>
