---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/brand/logo.webp';
import { company, social } from '../data/site';
import { localeFromPath, localizePath, t } from '../lib/i18n';
import { getSiteContent } from '../lib/site-content';

const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
const { nav, socialIntro } = getSiteContent(locale);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-col">
        <a class="brand" href={localizePath('/', locale)}>
          <Image src={logo} alt={company.name} widths={[180]} sizes="90px" loading="lazy" />
        </a>
        <p class="blurb">
          {t('footer.company_intro', locale)}
        </p>
      </div>

      <div class="foot-col">
        <h2>{t('footer.company', locale)}</h2>
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href={localizePath('/#contact', locale)}>{t('footer.contact', locale)}</a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h2>{t('footer.legal', locale)}</h2>
        <ul>
          <li><a href={localizePath('/privacy-policy', locale)}>{t('footer.privacy', locale)}</a></li>
          <li><a href={localizePath('/terms-conditions', locale)}>{t('footer.terms', locale)}</a></li>
          <li><a href={`mailto:${company.legalEmail}`}>{company.legalEmail}</a></li>
        </ul>
      </div>

      <div class="foot-col social-col">
        <h2>{t('footer.follow', locale)}</h2>
        <p class="social-copy">{socialIntro}</p>
        <div class="social-controls">
          {social.map((item) => item.href ? (
            <a
              class="social-control"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
            >
              <Icon name={item.icon} aria-hidden="true" />
            </a>
          ) : (
            <button
              type="button"
              class="social-control is-pending"
              aria-label={item.label}
              title="Profile URL pending"
              disabled
            >
              <Icon name={item.icon} aria-hidden="true" />
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <span class="age">18+</span>
      <p class="legal">
        {company.legalName}, {company.address}. Ace Games supplies games to licensed operators and
        does not offer gambling to consumers. Demo games on this site are free play only, with no
        prizes of monetary value.
      </p>
      <span class="copy">{new Date().getFullYear()} {company.name}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--ink-2); padding: var(--section-space-compact) 0 var(--sp-6); }
  .foot-grid {
    display: grid; grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr));
    gap: var(--sp-7); padding-bottom: var(--sp-7); border-bottom: 1px solid var(--line);
  }
  @media (max-width: 900px) {
    .foot-grid { grid-template-columns: 1fr 1fr; gap: var(--sp-6); }
    .foot-grid > :first-child { grid-column: 1 / -1; }
  }
  .brand { display: inline-flex; min-height: 44px; align-items: center; margin-bottom: var(--sp-4); }
  .brand :global(img) { height: 42px; width: auto; }
  .blurb { font-size: 14px; color: var(--fg-2); max-width: 38ch; }

  .foot-col h2 {
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif; font-size: 1.1rem; font-weight: 700;
    letter-spacing: 0.045em; line-height: 1; text-transform: uppercase; color: var(--brand);
    margin: 0 0 var(--sp-3);
  }
  .foot-col ul { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .foot-col li a {
    display: inline-flex; align-items: center; min-height: 40px;
    font-size: 14px; color: var(--fg-2); text-decoration: none;
  }
  .foot-col li a:hover { color: var(--fg); }
  .social-copy { max-width: 30ch; color: var(--fg-2); font-size: 14px; line-height: 1.55; }
  .social-controls { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-4); }
  .social-control {
    width: 46px; height: 46px; display: grid; place-items: center;
    padding: 0; font: inherit;
    color: var(--fg); background: var(--ink-3); border: 1px solid var(--line-2);
    border-radius: var(--radius-pill); text-decoration: none;
    transition: transform 220ms var(--ease), color 220ms var(--ease), border-color 220ms var(--ease), background 220ms var(--ease);
  }
  .social-control :global(svg) { width: 21px; height: 21px; }
  .social-control:hover { color: var(--brand); transform: translateY(-2px) scale(1.07); border-color: var(--brand); background: var(--ink-4); }
  a.social-control:active { transform: translateY(0) scale(0.97); }
  .social-control.is-pending { color: var(--fg-3); cursor: not-allowed; opacity: 0.72; }

  .foot-bottom {
    padding-top: var(--sp-5); display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-6);
    align-items: baseline; font-size: 12.5px; color: var(--fg-3);
  }
  .legal { max-width: 70ch; line-height: 1.6; }
  .copy { margin-left: auto; }
  .age {
    font-family: 'JetBrains Mono Variable', monospace; font-size: 11px;
    border: 1px solid var(--line-2); border-radius: var(--radius-pill);
    padding: 4px 10px; color: var(--fg-2);
  }
  @media (max-width: 520px) {
    .foot-grid { grid-template-columns: 1fr; }
    .foot-grid > :first-child { grid-column: auto; }
    .copy { margin-left: 0; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-control { transition: none; }
    .social-control:hover, a.social-control:active { transform: none; }
  }
</style>
