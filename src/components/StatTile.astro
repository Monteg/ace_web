---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import proofUsers from '../assets/site/proof-users.png';

interface Props {
  icon: string;
  value: string | null;
  label: string;
  /** Shown in place of the value when the owner has not supplied it yet. */
  placeholder?: string;
}

const { icon, value, label, placeholder = 'TBC' } = Astro.props;
const isUsersIcon = icon === 'proof-users';
---

<div class="stat">
  <span class="stat-icon" aria-hidden="true">
    {isUsersIcon ? (
      <Image src={proofUsers} alt="" widths={[82, 164]} sizes="(max-width: 420px) 64px, 82px" loading="lazy" />
    ) : (
      <Icon name={icon} />
    )}
  </span>
  <p class="stat-value tnum">
    {value ? value : <span class="need">{placeholder}</span>}
  </p>
  <p class="stat-label">{label}</p>
</div>

<style>
  .stat {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .stat-icon {
    display: grid;
    place-items: center;
    width: clamp(4rem, 5.4vw, 5.125rem);
    height: clamp(4rem, 5.4vw, 5.125rem);
    color: var(--brand);
    margin-bottom: var(--sp-3);
  }
  .stat-icon :global(svg),
  .stat-icon :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .stat-value {
    font-family: Tanker, 'Tanker Fallback', Arial, sans-serif;
    max-width: 100%;
    font-size: clamp(4.2rem, 5.25vw, 5.25rem);
    line-height: 0.82;
    color: var(--brand);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .stat-label {
    margin-top: var(--sp-2);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.35;
    font-weight: 400;
    color: var(--cream-ink-2);
  }

  @media (max-width: 420px) {
    .stat-value { font-size: 3.5rem; }
  }
</style>
