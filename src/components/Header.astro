---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/brand/logo.webp';
import { company } from '../data/site';
import EventAnnouncementBar from './event/EventAnnouncementBar.astro';
import { currentEvent } from '../data/events';
import OrbitBorder from './showcase/OrbitBorder.astro';
import { borderTrailDefaults } from '../data/border-trail-settings';
import { getSiteContent } from '../lib/site-content';
import { LOCALES, LOCALE_LABELS, localeFromPath, localizePath, stripLocale, t } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname, Astro.currentLocale);
const currentPath = stripLocale(Astro.url.pathname).replace(/\/$/, '').replace(/\.html$/, '') || '/';
const isEvent = currentPath === currentEvent.eventUrl;
const siteContent = getSiteContent(locale);
const headerCTA = isEvent ? { label: currentEvent.bookingLabel, href: currentEvent.bookingAnchor } : siteContent.CTA;
const navigation = siteContent.headerNav;
const categories = (['slot', 'instant', 'table'] as const).map((type) => ({
  type,
  label: t(`global.game_type.${type}`, locale),
}));
const localizedHome = localizePath('/', locale);
const languagePath = stripLocale(`${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`);
const borderTrailStyle = `--orbit-duration: ${borderTrailDefaults.orbitDuration}s; --orbit-length: ${borderTrailDefaults.orbitLength}%; --orbit-width: ${borderTrailDefaults.orbitWidth}px; --orbit-opacity: ${borderTrailDefaults.orbitOpacity}; --orbit-blur: ${borderTrailDefaults.orbitBlur}px;`;
---

<header class="site-header" id="siteHeader" data-home-path={localizedHome} data-open-label={t('header.menu.open', locale)} data-close-label={t('header.menu.close', locale)}>
  <EventAnnouncementBar />
  <div class="wrap">
    <nav class="nav" aria-label={t('global.aria.main_navigation', locale)}>
      <span class="nav-glow-fx" data-border-trail-host aria-hidden="true" style={borderTrailStyle}>
        <OrbitBorder />
      </span>

      <a class="brand" href={localizedHome}>
        <Image src={logo} alt={company.name} widths={[140, 280]} sizes="140px" loading="eager" />
      </a>

      <ul class="nav-links" id="navLinks">
        {navigation.map((item) => (
          stripLocale(item.href) === '/games' ? (
            <li class="games-item" data-games-dropdown>
              <div class="games-control">
                <a class="nav-link" href={item.href} data-games-link aria-current={currentPath === '/games' ? 'page' : undefined}>{item.label}</a>
                <button class="submenu-toggle" type="button" aria-label={t('header.games_menu.open', locale)} aria-expanded="false" aria-controls="navGamesMenu" data-games-toggle hidden>
                  <Icon name="ph:caret-down" aria-hidden="true" />
                </button>
              </div>
              <ul class="games-submenu" id="navGamesMenu" aria-label={t('header.games_menu.open', locale)}>
                {categories.map((category) => <li><a href={`${localizePath('/games', locale)}?type=${category.type}#games`}>{category.label}</a></li>)}
              </ul>
            </li>
          ) : (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={isEvent && stripLocale(item.href) === currentEvent.eventUrl ? 'page' : undefined}
                data-home-anchor={stripLocale(item.href).startsWith('/#') ? '' : undefined}
                data-event-track={stripLocale(item.href) === currentEvent.eventUrl ? 'event_nav_click' : undefined}
              >{item.label}</a>
            </li>
          )
        ))}
        <li class="nav-links-cta">
          {isEvent ? (
            <a class="btn btn-primary btn-sm" href={headerCTA.href} data-event-track="book_meeting_header">{headerCTA.label}</a>
          ) : (
            <a class="btn btn-primary btn-sm" href={headerCTA.href} data-smart-contact aria-haspopup="dialog" aria-controls="contact-dialog">{headerCTA.label}</a>
          )}
        </li>
      </ul>

      <div class="nav-end">
        <details class="language-switcher">
          <summary aria-label={t('header.language.label', locale)}>{locale.toUpperCase()}</summary>
          <div class="language-menu">
            {LOCALES.map((lang) => (
              <a href={localizePath(languagePath, lang)} lang={lang} hreflang={lang} aria-current={lang === locale ? 'page' : undefined}>
                {LOCALE_LABELS[lang]}
              </a>
            ))}
          </div>
        </details>
        {isEvent ? (
          <a class="btn btn-primary btn-sm nav-desktop-cta" href={headerCTA.href} data-event-track="book_meeting_header">{headerCTA.label}</a>
        ) : (
          <a class="btn btn-primary btn-sm nav-desktop-cta" href={headerCTA.href} data-smart-contact aria-haspopup="dialog" aria-controls="contact-dialog">{headerCTA.label}</a>
        )}
        <button class="burger" type="button" id="burger" aria-expanded="false" aria-controls="navLinks" aria-label={t('header.menu.open', locale)}>
          <span></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<style>
  :global(html) { --site-header-height: 120px; }
  :global(html:not(.event-campaign-active)) { --site-header-height: 76px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    min-height: 76px;
    pointer-events: none;
  }
  :global(html.event-campaign-active) .site-header { min-height: 120px; }
  .site-header .wrap {
    pointer-events: auto;
    padding-top: 12px;
    transition: padding-top 260ms var(--ease);
  }
  .nav {
    position: relative; isolation: isolate;
    display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: var(--sp-5); height: 64px;
    padding: 0 12px;
    background: color-mix(in srgb, var(--ink-0) 74%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid rgb(255 86 0 / 0.52);
    border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px -18px rgb(5 4 2 / 0.8);
    transition:
      height 260ms var(--ease),
      padding 260ms var(--ease),
      gap 260ms var(--ease),
      background-color 260ms var(--ease),
      box-shadow 260ms var(--ease);
  }
  .nav-glow-fx {
    position: absolute;
    inset: -1px;
    z-index: 2;
    overflow: visible;
    pointer-events: none;
    border-radius: inherit;
  }
  .nav:is(:hover, :focus-within) .nav-glow-fx {
    --orbit-halo-opacity: 0.68;
  }
  .brand { display: flex; align-items: center; justify-self: start; margin-left: 8px; min-height: 44px; text-decoration: none; }
  .brand :global(img) { height: 30px; width: auto; transition: height 260ms var(--ease); }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.45vw, 22px);
    list-style: none;
    transition: gap 260ms var(--ease);
  }
  .nav-links a,
  .nav-desktop-cta {
    font-family: Tanker, 'Tanker Fallback', 'Arial Narrow', Impact, sans-serif;
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.004em;
    text-transform: uppercase;
  }
  .nav-links a { color: var(--fg-2); text-decoration: none; white-space: nowrap; transition: color var(--dur-1); }
  .nav-link { display: inline-flex; align-items: center; min-height: 44px; font-size: 1.1875rem; }
  .nav-links a:hover { color: var(--fg); }
  .nav-links a[aria-current='page'] { color: var(--peach); }
  .nav-links-cta { display: none; }

  .nav-end { justify-self: end; display: flex; align-items: center; gap: var(--sp-3); }
  .language-switcher { position: relative; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; }
  .language-switcher summary {
    display: grid; place-items: center; width: 40px; height: 40px; cursor: pointer;
    color: var(--fg-2); border: 1px solid var(--line-2); border-radius: var(--radius-pill);
    list-style: none; text-transform: uppercase;
  }
  .language-switcher summary::-webkit-details-marker { display: none; }
  .language-switcher[open] summary, .language-switcher summary:hover { color: var(--fg); border-color: var(--brand); }
  .language-menu {
    position: absolute; top: calc(100% + 8px); right: 0; z-index: 20;
    display: grid; min-width: 132px; padding: 8px;
    background: var(--ink-2); border: 1px solid var(--line-2); border-radius: var(--radius);
    box-shadow: var(--shadow-2);
  }
  .language-menu a { min-height: 36px; display: flex; align-items: center; padding: 0 10px; color: var(--fg-2); text-decoration: none; border-radius: var(--radius-s); }
  .language-menu a:hover, .language-menu a[aria-current='page'] { color: var(--fg); background: var(--ink-3); }
  .site-header.is-compact .wrap { padding-top: 8px; }
  .site-header.is-compact .nav {
    height: 54px;
    gap: var(--sp-4);
    padding-inline: 10px;
    background: color-mix(in srgb, var(--ink-0) 84%, transparent);
    box-shadow: 0 12px 32px -20px rgb(5 4 2 / 0.88);
  }
  .site-header.is-compact .brand :global(img) { height: 28px; }
  .site-header.is-compact .nav-links { gap: clamp(12px, 1vw, 18px); }
  .games-item { position: relative; }
  .games-control { display: flex; align-items: center; }
  .submenu-toggle {
    display: grid; place-items: center; width: 44px; height: 44px;
    padding: 0; border: 0; border-radius: var(--radius-pill);
    background: transparent; color: var(--fg-2); cursor: pointer;
  }
  .submenu-toggle[hidden] { display: none; }
  .submenu-toggle:hover { color: var(--fg); background: var(--ink-3); }
  .submenu-toggle svg { width: 16px; height: 16px; transition: transform var(--dur-1) var(--ease); }
  .submenu-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .games-submenu {
    display: none; position: absolute; top: calc(100% + 8px); left: -16px;
    min-width: 200px; padding: var(--sp-2); list-style: none;
    background: var(--ink-2); border: 1px solid var(--line-2);
    border-radius: var(--radius); box-shadow: var(--shadow-2);
  }
  .games-submenu::before { content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: 8px; }
  .games-item[data-open='true'] .games-submenu { display: grid; animation: submenu-in var(--dur-1) var(--ease); }
  .games-submenu a {
    display: flex; align-items: center; min-height: 44px; padding: 10px 14px;
    border-radius: var(--radius-s); font-size: 1rem;
  }
  .games-submenu a:hover, .games-submenu a:focus-visible { color: var(--fg); background: var(--ink-3); }
  @keyframes submenu-in { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
  @media (min-width: 1121px) {
    .games-item:not([data-ready]):is(:hover, :focus-within) .games-submenu { display: grid; }
  }
  .burger {
    display: none; background: var(--brand); border: 0; border-radius: var(--radius-pill);
    width: 46px; height: 46px; cursor: pointer; align-items: center; justify-content: center;
  }
  .burger span {
    display: block; width: 20px; height: 2.5px; background: var(--on-brand-button);
    box-shadow: 0 -6px 0 var(--on-brand-button), 0 6px 0 var(--on-brand-button);
  }

  @media (max-width: 1120px) {
    .nav { grid-template-columns: minmax(0, 1fr) auto; }
    .nav-links { display: none; }
    .nav-desktop-cta { display: none; }
    .burger { display: flex; }
    .site-header.is-compact .nav { height: 58px; }
    .site-header.is-compact .brand :global(img) { height: 28px; }

    :global(.menu-open) .nav-links {
      display: flex; flex-direction: column; align-items: stretch; gap: 0;
      position: absolute; left: var(--gutter); right: var(--gutter); top: calc(100% + 8px);
      background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius-l);
      padding: var(--sp-2) var(--sp-5) var(--sp-5); box-shadow: var(--shadow-2);
      max-height: calc(100dvh - var(--site-header-height, 120px) - 24px); overflow-y: auto;
    }
    :global(.menu-open) .nav-links > li { border-bottom: 1px solid var(--line); }
    :global(.menu-open) .nav-link { display: flex; padding: 14px 0; font-size: 18px; }
    .games-control .nav-link { flex: 1; }
    .games-submenu { position: static; min-width: 0; padding: 0 0 var(--sp-3); border: 0; box-shadow: none; }
    .games-submenu::before { display: none; }
    .games-submenu a { padding-left: var(--sp-4); }
    :global(.menu-open) .nav-links-cta { display: block; border-bottom: 0; }
    :global(.menu-open) .nav-links-cta a { margin-top: var(--sp-4); justify-content: center; display: flex; color: var(--on-brand-button); }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header .wrap, .nav, .brand :global(img), .nav-links { transition: none; }
    .nav-glow-fx { display: none; }
    .games-item[data-open='true'] .games-submenu { animation: none; }
    .submenu-toggle svg { transition: none; }
  }
</style>

<script>
  import { mountBorderTrailSettings } from '../lib/border-trail';

  mountBorderTrailSettings();

  const header = document.getElementById('siteHeader');
  const burger = document.getElementById('burger');
  if (header && burger) {
    const dropdown = header.querySelector<HTMLElement>('[data-games-dropdown]');
    const toggle = header.querySelector<HTMLButtonElement>('[data-games-toggle]');
    const gamesLink = header.querySelector<HTMLAnchorElement>('[data-games-link]');
    const desktop = window.matchMedia('(min-width: 1121px)');
    const hover = window.matchMedia('(hover: hover)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const homepageHashes = new Set(['#about-us', '#our-benefits', '#why-ace-games', '#faq']);
    let closeTimer: ReturnType<typeof setTimeout>;
    let suppressFocusOpen = false;
    let openedFromFocus = false;
    let pointerToggleActive = false;
    let pointerStartedOpen = false;

    function setDropdown(open: boolean) {
      clearTimeout(closeTimer);
      if (dropdown && toggle) {
        dropdown.dataset.open = String(open);
        toggle.setAttribute('aria-expanded', String(open));
      }
    }

    function closeMenu(returnFocus = false) {
      header!.classList.remove('menu-open');
      burger!.setAttribute('aria-expanded', 'false');
      burger!.setAttribute('aria-label', header!.dataset.openLabel ?? 'Open menu');
      setDropdown(false);
      if (returnFocus) burger!.focus();
    }

    function scheduleClose() {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        if (!dropdown?.contains(document.activeElement) && !(desktop.matches && hover.matches && dropdown?.matches(':hover'))) setDropdown(false);
      }, 180);
    }
    if (dropdown && toggle && gamesLink) {
      dropdown.dataset.ready = 'true';
      toggle.hidden = false;
      dropdown.addEventListener('mouseenter', () => {
        if (desktop.matches && hover.matches) {
          openedFromFocus = false;
          setDropdown(true);
        }
      });
      dropdown.addEventListener('mouseleave', scheduleClose);
      dropdown.addEventListener('focusin', () => {
        if (desktop.matches && !suppressFocusOpen) {
          openedFromFocus = true;
          setDropdown(true);
        }
      });
      dropdown.addEventListener('focusout', scheduleClose);
      toggle.addEventListener('pointerdown', () => {
        pointerToggleActive = true;
        pointerStartedOpen = dropdown.dataset.open === 'true' && !openedFromFocus;
        suppressFocusOpen = true;
      });
      toggle.addEventListener('click', () => {
        setDropdown(pointerToggleActive ? !pointerStartedOpen : dropdown.dataset.open !== 'true');
        pointerToggleActive = false;
        openedFromFocus = false;
        suppressFocusOpen = false;
      });
      toggle.addEventListener('blur', () => {
        pointerToggleActive = false;
        suppressFocusOpen = false;
      });
      dropdown.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' && (event.target === gamesLink || event.target === toggle)) {
          event.preventDefault();
          setDropdown(true);
          dropdown.querySelector<HTMLAnchorElement>('.games-submenu a')?.focus();
        }
        if (event.key === 'Escape' && dropdown.dataset.open === 'true') {
          event.preventDefault();
          event.stopPropagation();
          setDropdown(false);
          suppressFocusOpen = true;
          (desktop.matches ? gamesLink : toggle).focus();
          suppressFocusOpen = false;
        }
      });
    }

    // The actual sticky height includes the existing campaign bar, if visible.
    const measureHeader = () => document.documentElement.style.setProperty('--site-header-height', `${header.offsetHeight}px`);
    new ResizeObserver(measureHeader).observe(header);
    measureHeader();

    const normalizePath = (path: string) => path.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
    const homePath = normalizePath(header.dataset.homePath ?? '/');
    const scrollToTarget = (target: HTMLElement, hash: string, updateHistory = true) => {
      if (updateHistory && window.location.hash !== hash) history.pushState(null, '', hash);
      target.scrollIntoView({ block: 'start', behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    };

    for (const link of header.querySelectorAll<HTMLAnchorElement>('[data-home-anchor]')) {
      link.addEventListener('click', (event) => {
        const url = new URL(link.href, window.location.href);
        if (normalizePath(window.location.pathname) !== homePath || normalizePath(url.pathname) !== homePath || !homepageHashes.has(url.hash)) return;
        const target = document.querySelector<HTMLElement>(url.hash);
        if (!target) return;
        event.preventDefault();
        closeMenu();
        scrollToTarget(target, url.hash);
      });
    }

    for (const trigger of header.querySelectorAll<HTMLAnchorElement>('[data-smart-contact]')) {
      trigger.addEventListener('click', (event) => {
        event.preventDefault();
        closeMenu();
        const contact = document.getElementById('contact');
        if (contact) {
          const distanceBelowViewport = Math.max(0, contact.getBoundingClientRect().top - window.innerHeight);
          if (distanceBelowViewport <= window.innerHeight * 1.75) {
            scrollToTarget(contact, '#contact');
            return;
          }
        }

        const dialog = document.getElementById('contact-dialog');
        if (dialog instanceof HTMLDialogElement && typeof dialog.showModal === 'function') {
          document.dispatchEvent(new CustomEvent('ace:open-contact', { detail: { opener: trigger } }));
        } else {
          window.location.assign(trigger.href);
        }
      });
    }

    if (homepageHashes.has(window.location.hash) && normalizePath(window.location.pathname) === homePath) {
      document.fonts.ready.then(() => requestAnimationFrame(() => {
        const target = document.querySelector<HTMLElement>(window.location.hash);
        if (target) scrollToTarget(target, window.location.hash, false);
      }));
    }

    const COMPACT_START_Y = 96;
    const DOWN_DISTANCE = 26;
    const UP_DISTANCE = 16;
    const SCROLL_NOISE = 2;
    let previousY = Math.max(0, window.scrollY);
    let downwardTravel = 0;
    let upwardTravel = 0;
    let scrollFrame = 0;

    const updateHeaderState = () => {
      scrollFrame = 0;
      const currentY = Math.max(0, window.scrollY);
      const delta = currentY - previousY;
      previousY = currentY;

      if (currentY <= COMPACT_START_Y) {
        downwardTravel = 0;
        upwardTravel = 0;
        header.classList.remove('is-compact');
        return;
      }
      if (Math.abs(delta) < SCROLL_NOISE) return;

      if (delta > 0) {
        downwardTravel += delta;
        upwardTravel = 0;
        if (downwardTravel >= DOWN_DISTANCE && !header.classList.contains('menu-open')) header.classList.add('is-compact');
      } else {
        upwardTravel += Math.abs(delta);
        downwardTravel = 0;
        if (upwardTravel >= UP_DISTANCE) header.classList.remove('is-compact');
      }
    };
    window.addEventListener('scroll', () => {
      if (!scrollFrame) scrollFrame = requestAnimationFrame(updateHeaderState);
    }, { passive: true });

    desktop.addEventListener('change', () => closeMenu());
    burger.addEventListener('click', () => {
      const open = header.classList.toggle('menu-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? header.dataset.closeLabel ?? 'Close menu' : header.dataset.openLabel ?? 'Open menu');
      if (open) header.classList.remove('is-compact');
      else setDropdown(false);
    });
    header.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.nav-links a')) {
        closeMenu();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('menu-open')) {
        closeMenu(true);
      }
    });
    document.addEventListener('click', (event) => { if (!header.contains(event.target as Node)) closeMenu(); });
  }
</script>
