---
import type { SiteLocale } from '../i18n/config';
import type { Translate } from '../i18n/get-translations';
import { switchLocaleUrl } from '../i18n/routes';

interface Props {
  locale: string;
  locales: SiteLocale[];
  t: Translate;
}

const { locale, locales, t } = Astro.props;
---

{locales.length > 1 && (
  <div class="language-switcher">
    <span class="sr-only">{t('language.label')}</span>
    <ul>
      {locales.map((item) => (
        <li>
          <a
            href={switchLocaleUrl(Astro.url, item.code, locales)}
            lang={item.code}
            hreflang={item.hreflang}
            aria-current={item.code === locale ? 'page' : undefined}
            aria-label={t('language.change_to', { language: item.nativeName })}
          >{item.code.toUpperCase()}</a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .language-switcher ul { display: flex; align-items: center; gap: 3px; list-style: none; }
  .language-switcher a {
    display: grid; place-items: center; min-width: 38px; min-height: 38px;
    padding: 6px 8px; border: 1px solid transparent; border-radius: var(--radius-pill);
    color: var(--fg-2); font-family: 'JetBrains Mono Variable', monospace;
    font-size: 10px; letter-spacing: 0.06em; text-decoration: none;
  }
  .language-switcher a:hover { color: var(--fg); border-color: var(--line-2); }
  .language-switcher a[aria-current='page'] { color: var(--brand); border-color: var(--brand-deep); }
</style>
