---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/fonts.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgeGate from '../components/AgeGate.astro';
import ContactModal from '../components/ContactModal.astro';
import { company } from '../data/site';
import { currentEvent } from '../data/events';
import { isCampaignActive } from '../lib/event';
import { getActiveLocales, defaultLocale } from '../i18n/config';
import { getTranslations } from '../i18n/get-translations';
import { localePath, stripLocalePrefix } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to the share image. */
  image?: string;
  /** Public clean URL when the static output filename differs from the route. */
  canonicalPath?: string;
  /** Extra JSON-LD to merge in, e.g. the Product graph on a game page. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Hide the public navigation and company footer on internal utility pages. */
  showSiteChrome?: boolean;
  /** Skip the global verification dialog on special routes such as /under-18. */
  showAgeGate?: boolean;
  /** Active content locale. English intentionally remains prefixless. */
  locale?: string;
  /** Events and internal utility pages stay English-only in v1. */
  enableLocaleAlternates?: boolean;
}

const {
  title,
  description,
  image = '/og-default.png',
  canonicalPath,
  schema,
  noindex = false,
  showSiteChrome = true,
  showAgeGate = true,
  locale = defaultLocale,
  enableLocaleAlternates = true,
} = Astro.props;

const allLocales = getActiveLocales();
const locales = enableLocaleAlternates ? allLocales : allLocales.filter((item) => item.code === defaultLocale);
const localeConfig = locales.find((item) => item.code === locale);
if (!localeConfig) throw new Error(`Cannot render inactive locale: ${locale}`);
const t = getTranslations(locale);

// Self-referencing canonical on every page. The old site had none, and three
// URLs served a byte-identical home page.
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? company.origin).href.replace(/\/$/, '') || company.origin;
const ogImage = new URL(image, Astro.site ?? company.origin).href;
const canonicalBasePath = stripLocalePrefix(canonicalPath ?? Astro.url.pathname, locales);
const alternates = locales.map((item) => ({
  ...item,
  href: new URL(localePath(canonicalBasePath, item.code, locales), Astro.site ?? company.origin).href,
}));

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  legalName: company.legalName,
  url: company.origin,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    addressLocality: company.city,
    postalCode: company.postcode,
    addressCountry: company.countryCode,
  },
  description,
};

const graphs = [organisation, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang={localeConfig.hreflang} dir={localeConfig.direction} class:list={{ 'event-campaign-active': isCampaignActive(currentEvent) }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline define:vars={{ eventCampaignWindow: [Date.parse(currentEvent.campaignStart), Date.parse(currentEvent.eventEnd)], eventAnnouncementKey: `ace-announcement-dismissed:${currentEvent.id}` }}>
      (() => {
        let timer;
        let dismissed = false;
        const update = () => {
          clearTimeout(timer);
          try {
            dismissed = dismissed || sessionStorage.getItem(eventAnnouncementKey) === 'true';
          } catch {
            // Closing still works on this page when browser storage is unavailable.
          }
          const now = Date.now();
          document.documentElement.classList.toggle('event-campaign-active', !dismissed && now >= eventCampaignWindow[0] && now < eventCampaignWindow[1]);
          const next = eventCampaignWindow.find(boundary => boundary > now);
          if (next) timer = setTimeout(update, Math.min(next - now + 50, 2147483647));
        };
        update();
        document.addEventListener('DOMContentLoaded', () => {
          const close = document.querySelector('[data-dismiss-event-announcement]');
          if (!close) return;
          close.hidden = false;
          close.addEventListener('click', () => {
            dismissed = true;
            try {
              sessionStorage.setItem(eventAnnouncementKey, 'true');
            } catch {
              // Do not fall back to permanent storage for a temporary dismissal.
            }
            update();
            document.querySelector('.site-header .brand')?.focus({ preventScroll: true });
          });
        });
        window.addEventListener('pageshow', update);
        document.addEventListener('visibilitychange', update);
      })();
    </script>

    <script is:inline define:vars={{ showAgeGate }}>
      (() => {
        if (!showAgeGate) return;
        try {
          const verified = localStorage.getItem('age_verified_18') === 'true';
          document.documentElement.classList.add(verified ? 'age-verified' : 'age-gate-required');
        } catch {
          document.documentElement.classList.add('age-gate-required');
        }
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((item) => <link rel="alternate" hreflang={item.hreflang} href={item.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(canonicalBasePath, defaultLocale, locales), Astro.site ?? company.origin).href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={localeConfig.hreflang.replace('-', '_')} />
    {alternates.filter((item) => item.code !== locale).map((item) => <meta property="og:locale:alternate" content={item.hreflang.replace('-', '_')} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#111111" />

    <link
      rel="preload"
      href="/fonts/Tanker-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {graphs.map((g) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(g)} />
    ))}
  </head>

  <body>
    {showAgeGate && <AgeGate locale={locale} />}
    <div id="siteShell">
      <a class="skip" href="#main">{t('global.skip_to_content')}</a>
      {showSiteChrome && <Header locale={locale} locales={locales} t={t} />}
      <main id="main" tabindex="-1">
        <slot />
      </main>
      {showSiteChrome && <Footer locale={locale} locales={locales} t={t} />}
      {showSiteChrome && <ContactModal locale={locale} />}

      <script>
        // Reveal on scroll. The page ships visible; this adds the hidden start
        // state, so if the script never runs the content is still readable.
        (() => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const targets = document.querySelectorAll<HTMLElement>('.rv');
          if (reduce || !('IntersectionObserver' in window) || !targets.length) return;

          document.documentElement.classList.add('rv-on');
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('in');
                  io.unobserve(e.target);
                }
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          for (const el of targets) {
            if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('in');
            else io.observe(el);
          }
        })();
      </script>
    </div>
  </body>
</html>
