# Cloudflare Pages -> Settings -> Variables and Secrets.
# Not read from this file at build time; it is here so you know what to set.
# Until all three exist the contact form redirects to /thanks?status=error.

# resend.com, free up to 3,000 emails a month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# where enquiries land
CONTACT_TO=info@acegames.io

# must be a verified sender on your own domain
CONTACT_FROM=site@acegames.io
