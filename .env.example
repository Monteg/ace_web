# Copy to .env for local tooling or configure the same names in the build host.
# This file contains names and safe placeholders only. Never commit real values.

# Website content source. Keep local until a CMS release passes parity checks.
CONTENT_SOURCE=local
CMS_URL=http://localhost:8055
CMS_BUILD_TOKEN=
CMS_RELEASE_ID=

# Directus and PostgreSQL development stack.
DATABASE_URL=postgresql://ace_cms:change-me@localhost:5432/ace_cms
POSTGRES_DB=ace_cms
POSTGRES_USER=ace_cms
POSTGRES_PASSWORD=change-me
DIRECTUS_KEY=replace-with-a-random-key
DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me

# Development uses local. Production can switch to s3 without changing code.
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Provider-neutral deployment hook used by release publishing.
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_SECRET=

# Google Sheets bridge. The token must belong to the scoped integration policy.
ACE_CMS_SYNC_TOKEN=

# Cloudflare Pages contact form. Until all three exist the form reports an
# honest delivery error rather than pretending the message was sent.
RESEND_API_KEY=
CONTACT_TO=info@acegames.io
CONTACT_FROM=site@acegames.io
