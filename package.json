    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^5.14.1",
    "astro-icon": "^1.1.5",
    "csv-parse": "^6.2.1",
    "gray-matter": "^4.0.3",
    "gsap": "^3.13.0",
    "marked": "^16.4.2",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.9.3"
  }
