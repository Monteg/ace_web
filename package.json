{
  "name": "acegames-showcase",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node --test scripts/content/content.test.mjs && node scripts/content/validate-generated.mjs && astro check",
