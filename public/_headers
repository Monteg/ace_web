# Only Cloudflare Pages reads this file. The site is served by nginx on the
# cluster, so deploy/nginx/snippets/security-headers.conf carries the same rules
# and is the one that is actually live. Change both.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), clipboard-read=(), clipboard-write=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src https://cdn.rstars.cc https://adapter-api-demo.rstars.cc; connect-src 'self'

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
