{
  "version": 1,
  "collections": [
    {
      "collection": "locales",
      "meta": {
        "icon": "translate",
        "note": "Languages available to the website and editors",
        "display_template": "{{native_name}} ({{code}})",
        "sort_field": "sort_order",
        "versioning": true
      },
      "fields": [
        { "field": "code", "type": "string", "schema": { "is_primary_key": true, "max_length": 12 }, "meta": { "interface": "input", "required": true, "width": "half" } },
        { "field": "name", "type": "string", "schema": { "max_length": 100 }, "meta": { "interface": "input", "required": true, "width": "half" } },
        { "field": "native_name", "type": "string", "schema": { "max_length": 100 }, "meta": { "interface": "input", "required": true, "width": "half" } },
        { "field": "is_default", "type": "boolean", "schema": { "default_value": false }, "meta": { "interface": "boolean", "required": true, "width": "half" } },
        { "field": "is_active", "type": "boolean", "schema": { "default_value": true }, "meta": { "interface": "boolean", "required": true, "width": "half" } },
        { "field": "sort_order", "type": "integer", "schema": { "default_value": 100 }, "meta": { "interface": "input", "required": true, "width": "half" } },
        { "field": "fallback_locale", "type": "string", "schema": { "max_length": 12, "is_nullable": true }, "meta": { "interface": "select-dropdown-m2o", "special": ["m2o"], "width": "half" } },
        { "field": "direction", "type": "string", "schema": { "default_value": "ltr", "max_length": 3 }, "meta": { "interface": "select-dropdown", "required": true, "width": "half", "options": { "choices": [{ "text": "Left to right", "value": "ltr" }, { "text": "Right to left", "value": "rtl" }] } } },
        { "field": "hreflang", "type": "string", "schema": { "max_length": 35 }, "meta": { "interface": "input", "required": true, "width": "half" } }
      ],
      "relations": [
        { "field": "fallback_locale", "related_collection": "locales", "on_delete": "SET NULL" }
      ]
    },
    {
      "collection": "content_releases",
      "meta": {
        "icon": "rocket_launch",
        "note": "Immutable public website release snapshots",
        "display_template": "v{{version}} · {{status}}",
        "sort_field": "version",
        "versioning": false
      },
      "fields": [
        { "field": "id", "type": "uuid", "schema": { "is_primary_key": true }, "meta": { "interface": "input", "special": ["uuid"], "hidden": true, "readonly": true } },
        { "field": "version", "type": "integer", "schema": { "is_unique": true }, "meta": { "interface": "input", "required": true, "readonly": true, "width": "half" } },
        { "field": "status", "type": "string", "schema": { "default_value": "draft", "max_length": 24 }, "meta": { "interface": "select-dropdown", "required": true, "width": "half", "options": { "choices": [{ "text": "Draft", "value": "draft" }, { "text": "Validating", "value": "validating" }, { "text": "Deploying", "value": "deploying" }, { "text": "Published", "value": "published" }, { "text": "Failed", "value": "failed" }, { "text": "Retired", "value": "retired" }] } } },
        { "field": "created_at", "type": "timestamp", "schema": {}, "meta": { "special": ["date-created"], "readonly": true, "hidden": true } },
        { "field": "created_by", "type": "uuid", "schema": { "is_nullable": true }, "meta": { "special": ["user-created", "m2o"], "interface": "select-dropdown-m2o", "readonly": true, "hidden": true } },
        { "field": "source_release", "type": "uuid", "schema": { "is_nullable": true }, "meta": { "special": ["m2o"], "interface": "select-dropdown-m2o", "width": "half" } },
        { "field": "is_active", "type": "boolean", "schema": { "default_value": false }, "meta": { "interface": "boolean", "required": true, "readonly": true, "width": "half" } },
        { "field": "payload", "type": "json", "schema": {}, "meta": { "interface": "input-code", "required": true, "readonly": true, "options": { "language": "json" } } },
        { "field": "checksum", "type": "string", "schema": { "max_length": 64 }, "meta": { "interface": "input", "required": true, "readonly": true, "width": "full" } },
        { "field": "deploy_status", "type": "string", "schema": { "is_nullable": true, "max_length": 32 }, "meta": { "interface": "input", "readonly": true, "width": "half" } },
        { "field": "deploy_id", "type": "string", "schema": { "is_nullable": true, "max_length": 255 }, "meta": { "interface": "input", "readonly": true, "width": "half" } },
        { "field": "deploy_url", "type": "string", "schema": { "is_nullable": true, "max_length": 2048 }, "meta": { "interface": "input", "readonly": true, "width": "full" } },
        { "field": "error_log", "type": "text", "schema": { "is_nullable": true }, "meta": { "interface": "input-multiline", "readonly": true, "width": "full" } }
      ],
      "relations": [
        { "field": "created_by", "related_collection": "directus_users", "on_delete": "SET NULL" },
        { "field": "source_release", "related_collection": "content_releases", "on_delete": "SET NULL" }
      ]
    }
  ],
  "seeds": {
    "locales": [
      { "code": "en", "name": "English", "native_name": "English", "is_default": true, "is_active": true, "sort_order": 1, "fallback_locale": null, "direction": "ltr", "hreflang": "en" },
      { "code": "it", "name": "Italian", "native_name": "Italiano", "is_default": false, "is_active": true, "sort_order": 2, "fallback_locale": "en", "direction": "ltr", "hreflang": "it" },
      { "code": "de", "name": "German", "native_name": "Deutsch", "is_default": false, "is_active": true, "sort_order": 3, "fallback_locale": "en", "direction": "ltr", "hreflang": "de" },
      { "code": "es", "name": "Spanish", "native_name": "Español", "is_default": false, "is_active": true, "sort_order": 4, "fallback_locale": "en", "direction": "ltr", "hreflang": "es" }
    ]
  },
  "folders": ["Games", "Site", "Brand", "Legacy"]
}
